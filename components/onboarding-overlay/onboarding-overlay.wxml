<view wx:if="{{visible && step}}" class="onboarding-root" catchtouchmove="noop">
  <view wx:if="{{highlightVisible}}" class="onboarding-highlight" style="{{highlightStyle}}"></view>
  <view class="onboarding-bubble" style="{{bubbleStyle}}">
    <view class="onboarding-progress">功能介绍 {{step.index + 1}} / {{step.total}}</view>
    <view class="onboarding-title">{{step.title}}</view>
    <view class="onboarding-description">{{step.description}}</view>
    <view class="onboarding-actions">
      <button class="onboarding-link" bindtap="skip">跳过</button>
      <view class="onboarding-spacer"></view>
      <button wx:if="{{step.index > 0}}" class="onboarding-secondary" bindtap="previous">上一步</button>
      <button class="onboarding-primary" bindtap="next">{{step.index === step.total - 1 ? '开始使用' : '下一步'}}</button>
    </view>
  </view>
</view>

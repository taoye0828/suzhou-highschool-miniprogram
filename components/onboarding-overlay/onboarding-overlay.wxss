.onboarding-root { position: fixed; inset: 0; z-index: 9999; }
.onboarding-highlight {
  position: fixed;
  z-index: 10000;
  border: 4rpx solid #5eead4;
  border-radius: 20rpx;
  box-shadow: 0 0 0 2400rpx rgba(15, 23, 42, 0.72);
  pointer-events: none;
}
.onboarding-bubble {
  position: fixed;
  z-index: 10001;
  box-sizing: border-box;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 18rpx 50rpx rgba(15, 23, 42, 0.2);
}
.onboarding-progress { color: #0f766e; font-size: 24rpx; font-weight: 700; }
.onboarding-title { margin-top: 12rpx; color: #0f172a; font-size: 34rpx; font-weight: 700; }
.onboarding-description { margin-top: 12rpx; color: #475569; font-size: 28rpx; line-height: 1.55; }
.onboarding-actions { display: flex; align-items: center; gap: 12rpx; margin-top: 24rpx; }
.onboarding-actions button { margin: 0; padding: 0 22rpx; min-width: 128rpx; line-height: 72rpx; font-size: 26rpx; }
.onboarding-spacer { flex: 1; }
.onboarding-link { color: #64748b; background: transparent; }
.onboarding-secondary { color: #0f766e; background: #e7f6f3; }
.onboarding-primary { color: #ffffff; background: #0f766e; }

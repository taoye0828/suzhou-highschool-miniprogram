<view class="page">
  <input class="input search" value="{{keyword}}" placeholder="搜索学校名称或简称" confirm-type="search" bindinput="onKeywordInput" />

  <view class="filter-row">
    <picker class="grow" range="{{districts}}" value="{{districtIndex}}" bindchange="onDistrictChange">
      <view class="input picker">区域：{{districts[districtIndex]}}⌄</view>
    </picker>
    <button class="button secondary filter-button" bindtap="toggleMoreFilters">{{showMoreFilters ? '收起筛选' : '更多筛选'}}</button>
  </view>

  <view wx:if="{{showMoreFilters}}" class="card filters">
    <text class="field-label">学校类型</text>
    <picker range="{{schoolTypes}}" value="{{schoolTypeIndex}}" bindchange="onSchoolTypeChange"><view class="input picker">{{schoolTypes[schoolTypeIndex]}}⌄</view></picker>
    <text class="field-label">参考年份</text>
    <picker range="{{years}}" value="{{yearIndex}}" bindchange="onYearChange"><view class="input picker">{{years[yearIndex]}}⌄</view></picker>
    <text class="field-label">历史参考分范围</text>
    <view class="row">
      <input class="input score-input" type="number" maxlength="3" value="{{minScore}}" placeholder="最低分" bindinput="onMinScoreInput" />
      <text>—</text>
      <input class="input score-input" type="number" maxlength="3" value="{{maxScore}}" placeholder="最高分" bindinput="onMaxScoreInput" />
    </view>
    <text class="field-label">排序</text>
    <picker range="{{sorts}}" range-key="label" value="{{sortIndex}}" bindchange="onSortChange"><view class="input picker">{{sorts[sortIndex].label}}⌄</view></picker>
    <view class="button-row"><button class="button secondary" bindtap="resetFilters">重置</button><button class="button" bindtap="applyScoreRange">应用筛选</button></view>
  </view>

  <view class="muted small result-count">找到 {{schoolRows.length}} 所学校</view>
  <view class="card school-card" wx:for="{{schoolRows}}" wx:key="id" data-id="{{item.id}}" bindtap="openSchool">
    <view class="row between">
      <view class="grow">
        <view class="card-title">{{item.name}}</view>
        <view class="muted small">{{item.district}} · {{item.schoolType}}</view>
      </view>
      <text wx:if="{{item.isTarget}}" class="badge">已加入目标</text>
    </view>
    <view class="reference-row"><text>{{item.referenceText}}</text><text class="muted small">{{item.yearText}}</text></view>
    <view class="view-detail">查看详情 ›</view>
  </view>
  <view wx:if="{{schoolRows.length === 0}}" class="card empty">没有符合条件的学校，请调整搜索或筛选条件。</view>
</view>

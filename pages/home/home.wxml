<view class="page">
  <view class="hero">
    <view class="hero-title">{{appName}}</view>
    <view class="hero-subtitle">{{homeTagline}}</view>
  </view>

  <view class="section-title">快速查学校</view>
  <view class="card home-search-card">
    <input
      class="input"
      value="{{schoolKeyword}}"
      placeholder="输入学校名称或简称，如：南航、苏中"
      bindinput="onSchoolKeywordInput"
    />
    <view
      wx:for="{{schoolSearchResults}}"
      wx:key="id"
      class="home-search-result row between"
      data-id="{{item.id}}"
      bindtap="openSchoolResult"
    >
      <view class="grow">
        <view class="card-title">{{item.name}}</view>
        <view class="muted small">{{item.district}} · {{item.schoolType}}</view>
      </view>
      <view class="list-arrow">›</view>
    </view>
    <view wx:if="{{schoolSearchActive && schoolSearchResults.length === 0}}" class="muted small search-empty">
      没有找到匹配学校。
    </view>
  </view>

  <view class="section-title">中考倒计时</view>
  <view class="card countdown-card" wx:if="{{countdown}}">
    <view class="row between countdown-head">
      <view class="grow">
        <view class="card-title">{{countdown.daysText}}</view>
        <view class="muted small countdown-date">目标日期：{{countdown.targetDateText}}</view>
      </view>
      <picker range="{{examYears}}" value="{{examYearIndex}}" bindchange="onExamYearChange">
        <view class="year-picker">{{examYears[examYearIndex]}} 年⌄</view>
      </picker>
    </view>
    <view class="muted small">目标年份只保存在本机，可随时调整。</view>
  </view>

  <view class="section-title">数据概况</view>
  <view class="card">
    <view class="card-title">{{scoreStats.verifiedText}}</view>
    <view class="notice">学校 {{scoreStats.schoolCount}} 所，历史分数线 {{scoreStats.scoreCount}} 条。</view>
    <view class="muted small">已收录年份：{{scoreStats.yearsText}}</view>
    <view class="muted small">数据核对日期：{{sourceCheckedAt}}</view>
    <view class="muted small">{{homeBoundary}}</view>
    <view class="muted small">{{localBoundary}}</view>
  </view>

  <view class="section-title">快捷入口</view>
  <view
    class="card entry"
    wx:for="{{entries}}"
    wx:key="title"
    data-route="{{item.route}}"
    data-tab="{{item.tab}}"
    bindtap="openEntry"
  >
    <view class="grow">
      <view class="card-title">{{item.title}}</view>
      <view class="muted small entry-subtitle">{{item.subtitle}}</view>
    </view>
    <view class="list-arrow">›</view>
  </view>

  <view class="section-title">使用步骤</view>
  <view class="card step-card">
    <view class="step-item" wx:for="{{usageSteps}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="card planning-notice">
    <view class="card-title">使用边界</view>
    <view class="muted small planning-notice-text">{{homeBoundary}}</view>
  </view>
</view>

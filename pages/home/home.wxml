<view class="page">
  <view class="card overview-card onboarding-home-overview">
    <view class="card-title">我的中考规划概览</view>
    <view class="overview-grid">
      <view><view class="muted small">最近成绩</view><view class="overview-value">{{latestScoreText}}</view></view>
      <view><view class="muted small">目标学校</view><view class="overview-value">{{targetCount}} 所</view></view>
    </view>
    <view class="muted small">{{scoreChangeText}}</view>
  </view>

  <view class="section-title">输入成绩，看目标学校</view>
  <view class="card score-start-card">
    <view class="score-start-row">
      <input
        class="input score-start-input"
        type="number"
        maxlength="3"
        value="{{scoreInput}}"
        placeholder="0 至 {{scoreMax}}"
        bindinput="onScoreInput"
      />
      <button class="button score-start-button" bindtap="startScoreAnalysis">查看推荐</button>
    </view>
    <view wx:if="{{scoreInputError}}" class="input-error">{{scoreInputError}}</view>
  </view>

  <view class="section-title">学校库</view>
  <view class="card home-search-card">
    <input
      class="input"
      value="{{schoolKeyword}}"
      placeholder="输入学校名称或简称，如：南航、苏中"
      bindinput="onSchoolKeywordInput"
    />
    <view
      wx:for="{{schoolSearchResults}}"
      wx:key="id"
      class="home-search-result row between"
      data-id="{{item.id}}"
      bindtap="openSchoolResult"
    >
      <view class="grow">
        <view class="card-title">{{item.name}}</view>
        <view class="muted small">{{item.district}} · {{item.schoolType}}</view>
      </view>
      <view class="list-arrow">›</view>
    </view>
    <view wx:if="{{schoolSearchActive && schoolSearchResults.length === 0}}" class="muted small search-empty">
      没有找到匹配学校。
    </view>
    <button class="button secondary school-library-button" bindtap="openSchools">打开学校库</button>
  </view>

  <view class="section-title">中考倒计时</view>
  <view class="card countdown-card onboarding-home-overview" wx:if="{{countdown}}">
    <view class="row between countdown-head">
      <view class="grow">
        <view class="card-title">{{countdown.daysText}}</view>
        <view class="muted small countdown-date">目标日期：{{countdown.targetDateText}}</view>
      </view>
      <picker range="{{examYears}}" value="{{examYearIndex}}" bindchange="onExamYearChange">
        <view class="year-picker">{{examYears[examYearIndex]}} 年⌄</view>
      </picker>
    </view>
  </view>
  <onboarding-overlay
    visible="{{onboarding.visible}}"
    step="{{onboarding.step}}"
    bind:action="onOnboardingAction"
  />
</view>

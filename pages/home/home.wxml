<view class="page">
  <view class="card" bindtap="openProfiles">
    <view class="row between">
      <view>
        <view class="muted small">当前档案</view>
        <view class="card-title">{{profileName}}</view>
      </view>
      <view class="list-arrow">切换 ›</view>
    </view>
  </view>

  <view class="card">
    <view class="muted small">中考倒计时 · {{examYear}} 年</view>
    <view class="countdown">{{countdown.daysText}}</view>
    <view class="muted small">{{countdown.targetDateText}}</view>
  </view>

  <view class="section-title">最近成绩</view>
  <view class="card" wx:if="{{latestScore}}">
    <view class="row between">
      <view>
        <view class="card-title">{{latestScore.examName}}</view>
        <view class="muted small">{{latestScore.examDate}}</view>
      </view>
      <view class="score">{{latestScore.totalScore}} 分</view>
    </view>
    <button class="button secondary card-action" bindtap="openScores">记录成绩</button>
  </view>
  <view class="card empty" wx:else>
    <view>还没有考试记录。</view>
    <button class="button card-action" bindtap="openScores">记录成绩</button>
  </view>

  <view class="section-title">目标学校</view>
  <view class="card" wx:if="{{targetCount}}">
    <view class="card-title">已加入 {{targetCount}} 所</view>
    <view class="muted target-names">{{targetNames}}</view>
    <button class="button secondary card-action" bindtap="openTargets">查看目标</button>
  </view>
  <view class="card empty" wx:else>
    <view>还没有目标学校。</view>
    <button class="button card-action" bindtap="openSchools">查找学校</button>
  </view>

  <view class="section-title">快捷入口</view>
  <view class="button-row">
    <button class="button" bindtap="openScores">记录成绩</button>
    <button class="button secondary" bindtap="openSchools">查找学校</button>
  </view>
</view>

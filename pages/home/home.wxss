.countdown-card {
  margin-bottom: 0;
  border-left: 8rpx solid #0f766e;
}
.countdown-head { align-items: flex-start; }
.countdown-head .card-title {
  margin-top: 8rpx;
  font-size: 38rpx;
}
.countdown-date { margin-top: 10rpx; }
.year-picker {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 14rpx 18rpx;
  color: #0f766e;
  background: #e7f6f3;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.empty-state-card { text-align: center; }
.empty-state-text { margin: 14rpx 0 22rpx; }
.score-card { border-left: 8rpx solid #14b8a6; }
.target-card { border-left: 8rpx solid #0f766e; }
.stage-card { border-left: 8rpx solid #f59e0b; }
.score-head,
.target-head { align-items: flex-start; }
.score-value {
  flex-shrink: 0;
  color: #0f766e;
  font-size: 42rpx;
  font-weight: 700;
}
.target-gap {
  flex-shrink: 0;
  max-width: 240rpx;
  color: #0f766e;
  font-size: 28rpx;
  font-weight: 700;
  text-align: right;
}
.status-line {
  margin: 18rpx 0 8rpx;
  color: #334155;
  line-height: 1.6;
}
.stage-title { margin: 8rpx 0; }
.card-action { margin-top: 20rpx; }
.shortcut-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.shortcut-button {
  width: 100%;
  min-width: 0;
}
.shortcut-button.wide { grid-column: 1 / -1; }

@media (max-width: 340px) {
  .shortcut-grid { grid-template-columns: 1fr; }
  .shortcut-button.wide { grid-column: auto; }
  .countdown-head { align-items: stretch; flex-direction: column; }
  .year-picker { margin: 12rpx 0 0; }
}

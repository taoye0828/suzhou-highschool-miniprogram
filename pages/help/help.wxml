<view class="page">
  <view class="section-title first-title">使用说明</view>
  <view class="card">
    <view class="instruction" wx:for="{{instructions}}" wx:key="*this">
      <text class="step-number">{{index + 1}}</text>
      <text class="grow">{{item}}</text>
    </view>
  </view>

  <view class="section-title">常见问题</view>
  <view class="card" wx:for="{{faqs}}" wx:key="question">
    <view class="card-title">{{item.question}}</view>
    <view class="muted answer">{{item.answer}}</view>
  </view>

  <view class="section-title">联系人工客服</view>
  <view class="card customer-service">
    <view class="muted">使用中遇到问题或有功能建议，可以通过以下方式联系我们。请勿发送身份证号、手机号等敏感个人信息。</view>
    <view class="contact-row">
      <view class="grow"><view class="muted small">邮箱反馈</view><view class="contact-value">{{email}}</view></view>
      <button class="button secondary small-button" bindtap="copyEmail">复制邮箱</button>
    </view>
    <view class="divider"></view>
    <view class="contact-row">
      <view class="grow"><view class="muted small">微信客服</view><view class="contact-value">微信号：{{wechat}}</view></view>
      <button class="button secondary small-button" bindtap="copyWechat">复制微信号</button>
    </view>
  </view>
</view>

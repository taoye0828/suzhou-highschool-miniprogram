<view class="page" wx:if="{{school}}">
  <swiper wx:if="{{images.length}}" class="school-gallery" indicator-dots="{{images.length > 1}}" circular="{{images.length > 1}}" autoplay="{{images.length > 1}}" interval="5000">
    <swiper-item wx:for="{{images}}" wx:key="imageId">
      <image wx:if="{{!item.failed}}" class="school-image" src="{{item.publicUrl}}" mode="aspectFill" lazy-load="true" data-id="{{item.imageId}}" catcherror="onImageError" />
      <view wx:else class="school-image image-placeholder">图片暂时无法显示</view>
      <view wx:if="{{item.title || item.description}}" class="image-caption"><text>{{item.title}}</text><text wx:if="{{item.description}}" class="small">{{item.description}}</text></view>
    </swiper-item>
  </swiper>
  <view wx:else class="school-image image-placeholder school-gallery">暂无校园图片</view>
  <view class="card">
    <view class="card-title school-name">{{school.name}}</view>
    <view class="muted">{{school.district}} · {{school.schoolType}}{{school.ownership ? ' · ' + school.ownership : ''}}</view>
    <view wx:if="{{school.campus}}" class="info-row"><text class="info-label">校区</text><text class="info-value">{{school.campus}}</text></view>
    <view wx:if="{{school.address}}" class="info-row"><text class="info-label">地址</text><text class="info-value">{{school.address}}</text></view>
    <view wx:if="{{school.phone}}" class="info-row"><text class="info-label">电话</text><text class="info-value">{{school.phone}}</text></view>
    <view wx:if="{{aliasesText}}" class="info-row"><text class="info-label">别名</text><text class="info-value">{{aliasesText}}</text></view>
    <view wx:if="{{school.description}}" class="info-row"><text class="info-label">简介</text><text class="info-value">{{school.description}}</text></view>
    <view wx:if="{{school.features}}" class="info-row"><text class="info-label">办学特色</text><text class="info-value">{{school.features}}</text></view>
    <view wx:for="{{officialInfoRows}}" wx:key="key" class="info-row"><text class="info-label">{{item.label}}</text><text class="info-value">{{item.value}}</text></view>
    <view wx:if="{{programsText}}" class="info-row"><text class="info-label">课程/项目</text><text class="info-value">{{programsText}}</text></view>
    <view class="button-row">
      <button class="button secondary small-button" data-value="{{school.name}}" data-success="学校名称已复制" bindtap="copyText">复制学校名称</button>
      <button class="button secondary small-button" data-value="{{mapSearchText}}" data-success="地图搜索词已复制" bindtap="copyText">复制地图搜索词</button>
      <button wx:if="{{school.address}}" class="button secondary small-button" data-value="{{school.address}}" data-success="地址已复制" bindtap="copyText">复制地址</button>
      <button wx:if="{{school.website || school.officialUrl}}" class="button secondary small-button" data-value="{{school.website || school.officialUrl}}" data-success="官网链接已复制" bindtap="copyText">复制官网链接</button>
    </view>
  </view>

  <button wx:if="{{!targetRecord}}" class="button target-action" bindtap="addTarget">加入目标学校</button>
  <button wx:else class="button danger target-action" bindtap="removeTarget">移出目标学校</button>

  <block wx:if="{{announcements.length}}">
    <view class="section-title">学校公告</view>
    <view class="card announcement-card" wx:for="{{announcements}}" wx:key="id" data-id="{{item.id}}" bindtap="openAnnouncement">
      <view class="row between"><view class="card-title">{{item.title}}</view><view class="muted small">{{item.dateText}}</view></view>
      <view wx:if="{{item.summary}}" class="muted announcement-summary">{{item.summary}}</view>
      <view class="view-detail">查看公告 ›</view>
    </view>
  </block>

  <view class="section-title">历史公开录取分数线</view>
  <view class="muted small score-notice">历史数据仅供了解，不代表未来录取结果。</view>
  <view class="card score-card" wx:for="{{scores}}" wx:key="id">
    <view class="row between"><view class="card-title">{{item.year}} 年</view><view class="score-value">{{item.minScore}} 分</view></view>
    <view class="muted small">{{item.detail}}</view>
    <view wx:if="{{item.sameScoreRule}}" class="muted small">{{item.sameScoreRule}}</view>
    <view class="source-title">{{item.sourceTitle}}</view>
    <button class="button secondary small-button source-button" data-value="{{item.sourceUrl}}" data-success="来源链接已复制" bindtap="copyText">复制来源链接</button>
  </view>
  <view wx:if="{{scores.length === 0}}" class="card empty">本校暂未收录已核实历史录取分数线。</view>

  <view class="section-title">学校信息来源</view>
  <view class="card">
    <view class="card-title">{{school.sourceTitle}}</view>
    <view class="muted small">核对日期：{{school.sourceCheckedAt}}</view>
    <view wx:if="{{school.sourceNote}}" class="muted source-note">{{school.sourceNote}}</view>
    <button class="button secondary source-button" data-value="{{school.sourceUrl}}" data-success="来源链接已复制" bindtap="copyText">复制来源链接</button>
  </view>
  <view wx:if="{{dataUpdatedAt}}" class="muted small updated-at">内容更新时间：{{dataUpdatedAt}}</view>
</view>
<view class="page" wx:elif="{{notFound}}">
  <view class="card empty">
    <view class="card-title">未找到这所学校</view>
    <view class="muted">该学校可能已从当前数据中移除，请返回学校库重新查找。</view>
    <button class="button" bindtap="goBack">返回学校库</button>
  </view>
</view>

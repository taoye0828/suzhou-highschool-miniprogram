<view class="page">
  <view wx:if="{{pageError}}" class="input-error">{{pageError}}</view>
  <view class="card">
    <view class="card-title">本机数据</view>
    <view class="info-row"><text class="info-label">当前档案</text><text class="info-value">{{activeProfileName}}</text></view>
    <view class="info-row"><text class="info-label">档案总数</text><text class="info-value">{{profileCount}} 个</text></view>
    <view class="info-row"><text class="info-label">收藏</text><text class="info-value">{{favoriteCount}} 所</text></view>
    <view class="info-row"><text class="info-label">目标学校</text><text class="info-value">{{targetCount}} 所</text></view>
    <view class="info-row"><text class="info-label">阶段目标</text><text class="info-value">{{learningTargetCount}} 条</text></view>
    <view class="info-row"><text class="info-label">成绩记录</text><text class="info-value">{{scoreCount}} 条</text></view>
    <view class="info-row"><text class="info-label">考试复盘 / 失分原因</text><text class="info-value">{{reviewCount}} / {{lossReasonCount}} 条</text></view>
    <view class="info-row"><text class="info-label">学习任务</text><text class="info-value">{{learningTaskCount}} 条</text></view>
    <view class="info-row"><text class="info-label">最近操作</text><text class="info-value">{{recentCount}} 条</text></view>
  </view>

  <view wx:if="{{hasStartupRecovery}}" class="card management-card">
    <view class="card-title">未完成数据操作</view>
    <view class="muted small management-note">检测状态：{{startupRecovery.state}}。请先重试自动判断；只有确认当前正式数据正确时才选择保留当前数据。</view>
    <button class="button secondary" disabled="{{operatingRecovery}}" bindtap="retryStartupRecovery">重新检查</button>
    <button class="button secondary" disabled="{{operatingRecovery}}" bindtap="keepFormalData">保留当前正式数据</button>
    <button wx:if="{{canUseTemporaryRecovery}}" class="button" disabled="{{operatingRecovery}}" bindtap="useTemporaryData">使用已校验的临时数据</button>
  </view>

  <view class="card">
    <view class="card-title">数据检查</view>
    <view class="muted small">只检查用户本地数据，不读取或修改正式学校与分数线文件。</view>
    <button class="button secondary" disabled="{{checkingData || repairingData}}" loading="{{checkingData}}" bindtap="runDataCheck">只读扫描</button>
    <view wx:if="{{healthReport}}" class="preview-box">
      <view>共 {{healthReport.total}} 项 · 可安全修复 {{healthReport.autoFixableCount}} 项 · 需人工处理 {{healthReport.manualCount}} 项</view>
      <view wx:for="{{healthReport.issues}}" wx:key="index" class="muted small">{{item.label}}：{{item.detail}}</view>
      <button wx:if="{{healthReport.autoFixableCount}}" class="button" disabled="{{checkingData || repairingData}}" loading="{{repairingData}}" bindtap="repairSafeData">创建恢复点并修复安全项</button>
      <button wx:if="{{repairResult}}" class="button secondary" disabled="{{checkingData || repairingData}}" bindtap="restoreBeforeRepair">恢复修复前快照</button>
    </view>
  </view>

  <view class="card management-card">
    <view class="card-title">恢复点</view>
    <view class="muted small management-note">危险操作前自动保留本机用户数据，最多保存 10 个；不包含学校和分数线。</view>
    <button class="button secondary" bindtap="openRestorePoints">管理恢复点</button>
  </view>

  <view class="card">
    <view class="card-title">最近浏览与操作</view>
    <view class="muted small">仅用于快速返回，不记录复盘正文或备注全文，也不会上传。</view>
    <button class="button secondary" bindtap="clearRecentOperations">单独清除最近操作</button>
  </view>
  <view class="card management-card">
    <view class="card-title">清除当前档案</view>
    <view class="muted small management-note">只清除当前档案的用户数据，不影响其他档案。</view>
    <button class="button danger" bindtap="clearCurrentProfile">清除当前档案</button>
  </view>
  <view class="card management-card">
    <view class="card-title">清除全部本地数据</view>
    <view class="muted small management-note">连续两次确认后清除全部档案和设置。学校资料和历史分数线不会被删除。</view>
    <button class="button danger" bindtap="clearAllLocalData">清除全部本地数据</button>
  </view>
</view>

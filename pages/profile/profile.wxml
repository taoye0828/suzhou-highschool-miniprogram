<view class="page">
  <view class="card" bindtap="openProfiles">
    <view class="row between">
      <view>
        <view class="muted small">当前学生档案</view>
        <view class="card-title">{{profileName}}</view>
        <view class="muted small">{{examYear}} 年中考</view>
      </view>
      <view class="list-arrow">管理 ›</view>
    </view>
  </view>

  <view class="section-title">我的工具</view>
  <view class="card menu" bindtap="openProfiles"><view><view class="card-title">学生档案管理</view><view class="muted small">创建、切换、改名或删除档案</view></view><view class="list-arrow">›</view></view>
  <view class="card menu" bindtap="openBackupRestore"><view><view class="card-title">数据备份与恢复</view><view class="muted small">导出、恢复或清理本机数据</view></view><view class="list-arrow">›</view></view>
  <view class="card menu" bindtap="openHelp"><view><view class="card-title">使用说明与常见问题</view><view class="muted small">查看操作说明并联系人工客服</view></view><view class="list-arrow">›</view></view>
  <view class="card menu" bindtap="openPrivacy"><view><view class="card-title">隐私说明</view></view><view class="list-arrow">›</view></view>
</view>

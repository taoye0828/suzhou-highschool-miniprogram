<view class="page">
  <view class="card current-score-card">
    <view class="muted small">最近一次考试总分</view>
    <view wx:if="{{currentScore !== null}}" class="current-score">{{currentScore}} 分</view>
    <view wx:if="{{currentScore !== null}}" class="muted small">{{latestExamName}}</view>
    <view wx:else class="muted empty-message">记录一次考试总分后，可以与目标学校的历史公开分数进行数字对照。</view>
  </view>

  <view class="section-title">目标学校</view>
  <view wx:if="{{targetCards.length === 0}}" class="card empty">
    <view>还没有目标学校。</view>
    <button class="button add-button" bindtap="openSchools">添加目标学校</button>
  </view>
  <view class="card target-card" wx:for="{{targetCards}}" wx:key="id">
    <view class="card-title">{{item.schoolName}}</view>
    <view class="info-row"><text class="info-label">历史参考年份</text><text class="info-value">{{item.referenceYear}}</text></view>
    <view class="info-row"><text class="info-label">历史公开参考分</text><text class="info-value">{{item.referenceScore}}</text></view>
    <view class="info-row"><text class="info-label">当前总分</text><text class="info-value">{{item.currentScore}}</text></view>
    <view class="info-row difference-row"><text class="info-label">数字差值</text><text class="info-value difference">{{item.difference}}</text></view>
    <view class="button-row"><button class="button secondary small-button" data-id="{{item.schoolId}}" bindtap="openSchool">学校详情</button><button class="button danger small-button" data-id="{{item.id}}" bindtap="removeTarget">移出目标</button></view>
  </view>

  <button wx:if="{{targetCards.length}}" class="button secondary add-button" bindtap="openSchools">添加目标学校</button>
  <view class="muted small disclaimer">按历史公开分数计算，仅供了解，不代表未来录取结果。</view>
</view>

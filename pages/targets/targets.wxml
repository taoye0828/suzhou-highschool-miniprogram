<view class="page">
  <view class="segment-control">
    <view class="segment {{activeSegment === 'schools' ? 'active' : ''}}" data-segment="schools" bindtap="selectSegment">目标学校</view>
    <view class="segment {{activeSegment === 'learning' ? 'active' : ''}}" data-segment="learning" bindtap="selectSegment">阶段目标</view>
  </view>

  <block wx:if="{{activeSegment === 'schools'}}">
  <view class="card target-search-card onboarding-target-planning">
    <view class="card-title">搜索并添加目标学校</view>
    <input
      class="input target-search-input"
      value="{{keyword}}"
      placeholder="输入学校名称或简称"
      bindinput="onKeywordInput"
    />
    <view
      wx:for="{{searchResults}}"
      wx:key="id"
      class="target-search-result row between"
      data-school-id="{{item.id}}"
      bindtap="openSchool"
    >
      <view class="grow">
        <view class="card-title">{{item.name}}</view>
        <view class="muted small">{{item.district}} · 打开详情选择等级</view>
      </view>
      <view class="list-arrow">›</view>
    </view>
    <view wx:if="{{searchActive && searchResults.length === 0}}" class="muted small search-empty">
      没有找到可添加的匹配学校。
    </view>
  </view>

  <view class="row between section-row">
    <view class="section-title records-title">目标学校（{{records.length}}）</view>
    <button wx:if="{{records.length > 0}}" class="button danger small-button" bindtap="clearAllRecords">清空全部</button>
  </view>

  <view wx:if="{{records.length === 0}}" class="card empty">
    <view class="card-title">暂无目标学校</view>
    <view class="muted small empty-note">请先进入学校库，打开学校详情后选择等级并加入目标。</view>
    <button class="button empty-button" bindtap="openSchools">选择学校</button>
  </view>

  <view class="card record-card" wx:for="{{records}}" wx:key="id">
    <view class="row between">
      <view class="grow">
        <view class="record-level">{{item.levelLabel}}</view>
        <view class="card-title">{{item.schoolName}}</view>
      </view>
      <button class="button danger small-button" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
    </view>
    <view class="target-metrics">
      <view class="info-row"><text class="info-label">历史参考目标</text><text class="info-value">{{item.referenceScoreText}}</text></view>
      <view class="info-row"><text class="info-label">参考年份</text><text class="info-value">{{item.referenceYearText}}</text></view>
      <view class="info-row"><text class="info-label">我的成绩</text><text class="info-value">{{item.currentScoreText}}</text></view>
      <view class="info-row"><text class="info-label">当前差距</text><text class="info-value">{{item.gapText}}</text></view>
    </view>
    <picker
      range="{{targetLevels}}"
      range-key="label"
      value="{{item.levelIndex}}"
      data-id="{{item.id}}"
      bindchange="onLevelChange"
    >
      <view class="input level-picker">修改等级：{{item.levelLabel}}⌄</view>
    </picker>
    <button class="button secondary detail-button" data-school-id="{{item.schoolId}}" bindtap="openSchool">查看学校详情</button>
  </view>

  </block>

  <block wx:if="{{activeSegment === 'learning'}}">
  <view class="card learning-form">
    <text class="field-label">阶段目标</text>
    <input class="input" value="{{learningDraft.stage}}" maxlength="40" placeholder="例如：下次月考" data-field="stage" bindinput="updateLearningDraft" />
    <text class="field-label">目标分数</text>
    <input class="input" type="number" maxlength="3" value="{{learningDraft.targetScore}}" placeholder="0 至 740" data-field="targetScore" bindinput="updateLearningDraft" />
    <text class="field-label">备注</text>
    <textarea class="input learning-note" value="{{learningDraft.note}}" maxlength="200" placeholder="可选，请勿填写个人敏感信息" data-field="note" bindinput="updateLearningDraft"></textarea>
    <view wx:if="{{learningError}}" class="input-error">{{learningError}}</view>
    <button class="button" bindtap="saveLearningTarget">保存阶段目标</button>
  </view>
  <view class="row between section-row">
    <view class="section-title records-title">阶段目标（{{learningRecords.length}}）</view>
    <button wx:if="{{learningRecords.length > 0}}" class="button danger small-button" bindtap="clearLearningTargets">清空全部</button>
  </view>
  <view wx:if="{{learningRecords.length === 0}}" class="card empty">
    <view class="card-title">暂无阶段目标</view>
    <view class="muted small">保存一个下一阶段的分数目标，方便持续复盘。</view>
  </view>
  <view class="card record-card" wx:for="{{learningRecords}}" wx:key="id">
    <view class="row between">
      <view class="grow">
        <view class="card-title">{{item.stage}}</view>
        <view class="record-level">目标 {{item.targetScore}} 分</view>
      </view>
      <button class="button danger small-button" data-id="{{item.id}}" bindtap="deleteLearningTarget">删除</button>
    </view>
    <view wx:if="{{item.note}}" class="muted small learning-record-note">{{item.note}}</view>
  </view>
  </block>
  <onboarding-overlay
    visible="{{onboarding.visible}}"
    step="{{onboarding.step}}"
    bind:action="onOnboardingAction"
  />
</view>

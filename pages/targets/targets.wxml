<view class="page target-center-page">
  <view class="segment-control onboarding-target-planning">
    <view
      wx:for="{{segments}}"
      wx:key="value"
      class="segment {{activeSegment === item.value ? 'active' : ''}}"
      data-segment="{{item.value}}"
      bindtap="selectSegment"
    >{{item.label}}</view>
  </view>

  <block wx:if="{{activeSegment === 'recommendation'}}">
    <view class="card muted small boundary-card">
      <view>分组仅根据用户选择的历史成绩与学校历史公开分数线计算分差，不考虑招生计划、排名、指标生、批次变化、政策变化和当年试卷难度，不构成录取判断或志愿建议。</view>
      <view>历史公开数据整理，仅供目标规划参考。</view>
    </view>
    <view class="card recommendation-input-card">
      <view class="row between card-heading-row">
        <view>
          <view class="card-title">历史分差参考</view>
          <view class="muted small source-note">{{recommendationScoreSource}}</view>
        </view>
        <button class="text-button" bindtap="openScoreCenter">成绩中心</button>
      </view>
      <text class="field-label">当前成绩</text>
      <input
        class="input onboarding-score-input"
        type="number"
        maxlength="3"
        value="{{recommendationScoreInput}}"
        placeholder="请输入 0 至 {{scoreMax}} 的整数"
        bindinput="onRecommendationScoreInput"
      />
      <button wx:if="{{hasManualReferenceScore}}" class="text-button" bindtap="restoreFormalReferenceScore">恢复使用正式参考成绩</button>
      <view class="two-column-fields">
        <view>
          <text class="field-label">下一阶段目标（可留空）</text>
          <input
            class="input"
            type="number"
            maxlength="3"
            value="{{stageScenarioInput}}"
            placeholder="0 至 {{scoreMax}}"
            data-field="stageScenarioInput"
            bindinput="onScenarioScoreInput"
          />
        </view>
        <view>
          <text class="field-label">中考目标（可留空）</text>
          <input
            class="input"
            type="number"
            maxlength="3"
            value="{{finalScenarioInput}}"
            placeholder="0 至 {{scoreMax}}"
            data-field="finalScenarioInput"
            bindinput="onScenarioScoreInput"
          />
        </view>
      </view>
      <text class="field-label">目标考试年份</text>
      <picker range="{{targetYears}}" value="{{targetYearIndex}}" bindchange="onTargetYearChange">
        <view class="input picker-input">{{targetYears[targetYearIndex]}} 年⌄</view>
      </picker>
      <view wx:if="{{recommendationError}}" class="input-error">{{recommendationError}}</view>
      <view wx:if="{{scenarioError}}" class="input-error">{{scenarioError}}</view>
      <view class="row action-row">
        <button class="button grow onboarding-analyze-button" bindtap="analyzeRecommendations">查看历史分差参考</button>
        <button class="button secondary grow" bindtap="analyzeScenarios">对比三个情景</button>
        <button class="button secondary grow" bindtap="toggleRecommendationSettings">
          {{recommendationSettingsOpen ? '收起设置' : '参考设置'}}
        </button>
      </view>
    </view>

    <view wx:if="{{scenarioCards.length}}" class="section-title">个人成绩情景规划</view>
    <view
      wx:for="{{scenarioCards}}"
      wx:key="key"
      wx:for-item="scenario"
      class="card"
    >
      <view class="row between">
        <view class="card-title">{{scenario.label}} · {{scenario.score}} 分</view>
        <view class="muted small">
          {{scenario.improvementFromCurrent > 0 ? '较当前 +' + scenario.improvementFromCurrent : scenario.improvementFromCurrent < 0 ? '较当前 ' + scenario.improvementFromCurrent : '当前基准'}}
        </view>
      </view>
      <view class="muted small">冲刺 {{scenario.counts.sprint}} · 目标 {{scenario.counts.target}} · 保底 {{scenario.counts.safe}}</view>
      <view
        wx:for="{{scenario.results}}"
        wx:key="schoolId"
        wx:for-item="school"
        class="preview-box"
      >
        <view class="row between">
          <view>
            <view class="card-title">{{school.schoolName}}</view>
            <view class="muted small">{{school.level === 'sprint' ? '冲刺' : school.level === 'target' ? '目标' : '保底'}} · {{school.year}} 年参考 {{school.schoolScore}} 分</view>
          </view>
          <view>{{school.difference > 0 ? '+' : ''}}{{school.difference}} 分</view>
        </view>
        <view class="muted small">{{school.isTargetSchool ? '已选目标在本情景中为：' + (school.level === 'sprint' ? '冲刺' : school.level === 'target' ? '目标' : '保底') : '尚未加入目标'}}</view>
        <view class="button-row">
          <button class="button secondary grow" data-school-id="{{school.schoolId}}" bindtap="openSchool">详情</button>
          <button class="button secondary grow" data-school-id="{{school.schoolId}}" bindtap="toggleScenarioFavorite">{{school.isFavorite ? '取消收藏' : '收藏'}}</button>
          <button class="button grow" data-school-id="{{school.schoolId}}" data-scenario-key="{{scenario.key}}" bindtap="addScenarioTarget">{{school.isTargetSchool ? '更新目标等级' : '加入目标'}}</button>
        </view>
      </view>
    </view>

    <view wx:if="{{recommendationSettingsOpen}}" class="card recommendation-settings-card">
      <view class="row between">
        <view class="card-title">参考设置</view>
        <button class="text-button danger-text" bindtap="resetRecommendationSettings">恢复默认</button>
      </view>

      <view class="settings-group">
        <view class="field-label">地区（同类多选为“或”）</view>
        <checkbox-group class="choice-grid" bindchange="onDistrictChange">
          <label class="choice-item" wx:for="{{districtOptions}}" wx:key="value">
            <checkbox value="{{item.value}}" checked="{{item.checked}}" color="#0f766e" />
            <text>{{item.label}}</text>
          </label>
        </checkbox-group>
      </view>

      <view class="settings-group">
        <view class="field-label">学校类型（同类多选为“或”）</view>
        <checkbox-group class="choice-grid" bindchange="onSchoolTypeChange">
          <label class="choice-item" wx:for="{{schoolTypeOptions}}" wx:key="value">
            <checkbox value="{{item.value}}" checked="{{item.checked}}" color="#0f766e" />
            <text>{{item.label}}</text>
          </label>
        </checkbox-group>
      </view>

      <view class="settings-group">
        <view class="field-label">参考年份</view>
        <picker
          range="{{referenceYearOptions}}"
          range-key="label"
          value="{{referenceYearIndex}}"
          bindchange="onReferenceYearChange"
        >
          <view class="input picker-input">{{referenceYearOptions[referenceYearIndex].label}}⌄</view>
        </picker>
      </view>

      <view class="switch-row row between">
        <view>
          <view class="switch-title">允许回退上一已收录年份</view>
          <view class="muted tiny">目标年份无数据时，可使用更早的已核实公开数据。</view>
        </view>
        <switch
          checked="{{recommendationSettings.allow2025Fallback}}"
          color="#0f766e"
          data-field="allow2025Fallback"
          bindchange="onRecommendationSwitch"
        />
      </view>
      <view class="switch-row row between">
        <view class="switch-title">只看收藏学校</view>
        <switch
          checked="{{recommendationSettings.favoritesOnly}}"
          color="#0f766e"
          data-field="favoritesOnly"
          bindchange="onRecommendationSwitch"
        />
      </view>
      <view class="switch-row row between">
        <view class="switch-title">排除已加入目标的学校</view>
        <switch
          checked="{{recommendationSettings.excludeTargetSchools}}"
          color="#0f766e"
          data-field="excludeTargetSchools"
          bindchange="onRecommendationSwitch"
        />
      </view>

      <view class="settings-group">
        <view class="field-label">固定历史分差区间</view>
        <view class="muted tiny rule-help">当前成绩 - 学校参考分：冲刺 -30 至 -1，目标 0 至 15，保底高于 15；每组最多 5 所。</view>
      </view>
    </view>

    <view wx:if="{{recommendationHasRun}}" class="recommendation-summary row between">
      <view class="section-title">历史分差参考结果</view>
      <view class="muted small">共 {{recommendationCount}} 所</view>
    </view>
    <view wx:if="{{recommendationHasRun && recommendationCount === 0}}" class="card empty">
      <view class="card-title">当前条件下暂无结果</view>
      <view class="muted small empty-note">可以调整地区或参考年份；历史分差区间保持固定。</view>
      <button class="button secondary empty-button" bindtap="resetRecommendationSettings">恢复默认设置</button>
    </view>

    <view
      wx:for="{{recommendationSections}}"
      wx:key="value"
      wx:for-item="section"
      class="recommendation-section"
    >
      <view wx:if="{{recommendationHasRun}}" class="section-title section-heading">
        {{section.label}}（{{section.results.length}}）
      </view>
      <view wx:if="{{recommendationHasRun}}" class="muted tiny section-description">{{section.description}}</view>
      <view
        wx:for="{{section.results}}"
        wx:key="schoolId"
        wx:for-item="result"
        class="card recommendation-card"
      >
        <view class="row between school-title-row" data-school-id="{{result.schoolId}}" bindtap="openSchool">
          <view class="grow">
            <view class="card-title">{{result.schoolName}}</view>
            <view class="muted small">{{result.district}} · {{result.schoolType}}</view>
          </view>
          <view class="list-arrow">›</view>
        </view>
        <view class="recommendation-metrics">
          <view class="metric">
            <text class="metric-label">参考分</text>
            <text class="metric-value">{{result.schoolScore}} 分</text>
          </view>
          <view class="metric">
            <text class="metric-label">年份</text>
            <text class="metric-value">{{result.year}} 年</text>
          </view>
          <view class="metric">
            <text class="metric-label">当前分差</text>
            <text class="metric-value {{result.differenceClass}}">{{result.difference > 0 ? '+' : ''}}{{result.difference}} 分</text>
          </view>
        </view>
        <view wx:if="{{result.isTargetSchool}}" class="target-badge">已是{{result.targetLevel === 'sprint' ? '冲刺' : result.targetLevel === 'safe' ? '保底' : '目标'}}学校</view>
        <view class="row card-actions">
          <button class="button secondary grow" data-school-id="{{result.schoolId}}" bindtap="openSchool">查看学校</button>
          <button class="button grow" data-school-id="{{result.schoolId}}" bindtap="addRecommendationTarget">{{result.actionText}}</button>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{activeSegment === 'schools'}}">
    <view class="card target-summary-card row between">
      <view>
        <view class="muted small">当前成绩</view>
        <view class="summary-score">{{currentScoreText}}</view>
      </view>
      <button class="button secondary compact-button" bindtap="openSchools">添加学校</button>
    </view>

    <view class="row between section-row">
      <view class="section-title">目标学校（{{records.length}}）</view>
      <button wx:if="{{records.length > 0}}" class="text-button danger-text" bindtap="clearAllTargets">清空目标学校</button>
    </view>

    <view wx:if="{{records.length === 0}}" class="card empty">
      <view class="card-title">暂无目标学校</view>
      <view class="muted small empty-note">可以从推荐结果或学校详情加入目标，并设置冲刺、目标或保底等级。</view>
      <button class="button empty-button" bindtap="openSchools">前往学校库</button>
    </view>

    <view class="card target-card" wx:for="{{records}}" wx:key="id">
      <view class="row between target-card-heading">
        <view class="grow">
          <view class="badge-row">
            <text class="level-badge">{{item.levelLabel}}</text>
            <text wx:if="{{item.isPrimary}}" class="primary-badge">主要目标</text>
          </view>
          <view class="card-title target-school-name">{{item.schoolName}}</view>
        </view>
        <button
          wx:if="{{!item.isPrimary}}"
          class="text-button"
          data-school-id="{{item.schoolId}}"
          bindtap="setPrimaryTarget"
        >设为主要</button>
      </view>

      <view class="target-metrics">
        <view class="info-row"><text class="info-label">历史参考分</text><text class="info-value">{{item.referenceScoreText}}</text></view>
        <view class="info-row"><text class="info-label">参考年份</text><text class="info-value">{{item.referenceYearText}}</text></view>
        <view class="info-row"><text class="info-label">我的成绩</text><text class="info-value">{{item.currentScoreText}}</text></view>
        <view class="info-row"><text class="info-label">当前分差</text><text class="info-value {{item.differenceClass}}">{{item.differenceText}}</text></view>
        <view class="info-row"><text class="info-label">首次至今</text><text class="info-value">{{item.firstChangeText}}</text></view>
        <view class="info-row"><text class="info-label">最近变化</text><text class="info-value">{{item.recentChangeText}}</text></view>
      </view>

      <picker
        range="{{targetLevels}}"
        range-key="label"
        value="{{item.levelIndex}}"
        data-id="{{item.id}}"
        bindchange="onLevelChange"
      >
        <view class="input level-picker">目标等级：{{item.levelLabel}}⌄</view>
      </picker>

      <view class="trajectory-heading row between">
        <view class="field-label">最近 {{item.visibleTrendPoints.length}} 次分差轨迹</view>
        <view class="muted tiny">点、名称和日期共用同一横坐标</view>
      </view>
      <view wx:if="{{item.visibleTrendPoints.length === 0}}" class="trajectory-empty muted small">
        记录成绩后显示目标差距变化。
      </view>
      <scroll-view wx:else scroll-x enhanced class="trajectory-scroll">
        <view class="trajectory-shell" style="width: {{item.plotWidthRpx}}rpx;">
          <view class="trajectory-chart">
            <view class="reference-line" style="{{item.referenceLineStyle}}">
              <text class="reference-label">参考分 {{item.referenceScoreText}}</text>
            </view>
            <block wx:for="{{item.visibleTrendPoints}}" wx:key="recordId" wx:for-item="point">
              <view class="trajectory-score-label" style="{{point.scoreStyle}}">{{point.score}}</view>
              <view class="trajectory-point" style="{{point.pointStyle}}"></view>
            </block>
          </view>
          <view class="trajectory-labels">
            <view
              wx:for="{{item.visibleTrendPoints}}"
              wx:key="recordId"
              wx:for-item="point"
              class="trajectory-label"
              style="{{point.labelStyle}}"
            >
              <view class="trajectory-index">第 {{point.displayIndex}} 次</view>
              <view class="trajectory-name">{{point.examName}}</view>
              <view class="trajectory-date">{{point.shortDate}}</view>
              <view class="trajectory-gap">{{point.difference > 0 ? '+' : ''}}{{point.difference}}</view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="row card-actions">
        <button class="button secondary grow" data-school-id="{{item.schoolId}}" bindtap="openSchool">学校详情</button>
        <button class="button danger grow" data-id="{{item.id}}" bindtap="deleteTarget">删除目标</button>
      </view>
    </view>
  </block>

  <block wx:if="{{activeSegment === 'learning'}}">
    <view wx:if="{{goalProgressSummary}}" class="card">
      <view class="card-title">学习目标进度</view>
      <view class="info-row"><text>本周任务</text><text>{{goalProgressSummary.thisWeek.length}} 条</text></view>
      <view class="info-row"><text>已完成 / 未完成</text><text>{{goalProgressSummary.completedCount}} / {{goalProgressSummary.incompleteCount}}</text></view>
      <view class="info-row"><text>即将到期 / 已暂停</text><text>{{goalProgressSummary.dueSoonCount}} / {{goalProgressSummary.pausedCount}}</text></view>
      <view class="muted small">完成学习任务不会自动把阶段目标标记为完成；新成绩也不会改写目标分。</view>
    </view>

    <view class="row between section-row">
      <view class="section-title">学习任务（{{learningTasks.length}}）</view>
    </view>
    <view wx:if="{{learningTasks.length === 0}}" class="card empty">
      <view class="card-title">暂无学习任务</view>
      <view class="muted small">可在成绩复盘中，从一条失分原因创建任务。</view>
    </view>
    <view class="card" wx:for="{{learningTasks}}" wx:key="id" wx:for-item="task">
      <view class="row between">
        <view>
          <view class="card-title">{{task.title}}</view>
          <view class="muted small">{{task.subjectName || '未指定学科'}} · 截止 {{task.dueDate || '未设置'}}</view>
        </view>
        <text class="status-badge status-{{task.status}}">{{task.status === 'not_started' ? '未开始' : task.status === 'in_progress' ? '进行中' : task.status === 'completed' ? '已完成' : '已暂停'}}</text>
      </view>
      <view class="muted small">每周 {{task.weeklyTarget || '—'}} 次 · {{task.sourceStatusText}}</view>
      <picker
        range="{{statusOptions}}"
        range-key="label"
        value="{{task.status === 'not_started' ? 0 : task.status === 'in_progress' ? 1 : task.status === 'completed' ? 2 : 3}}"
        data-id="{{task.id}}"
        bindchange="onLearningTaskStatusChange"
      >
        <view class="input level-picker">更新任务状态⌄</view>
      </picker>
      <button class="button danger" data-id="{{task.id}}" bindtap="deleteLearningTask">删除任务</button>
    </view>

    <view class="card learning-form-card">
      <view class="row between">
        <view class="card-title">{{learningDraft.id ? '编辑学习目标' : '新建学习目标'}}</view>
        <button wx:if="{{learningDraft.id || learningDraft.title}}" class="text-button" bindtap="resetLearningForm">新建</button>
      </view>

      <text class="field-label">阶段目标名称</text>
      <input class="input" value="{{learningDraft.title}}" maxlength="80" placeholder="例如：期中考试阶段目标" data-field="title" bindinput="updateLearningInput" />

      <view class="date-grid">
        <view>
          <text class="field-label">开始日期</text>
          <picker mode="date" value="{{learningDraft.startDate}}" data-field="startDate" bindchange="updateLearningDate">
            <view class="input picker-input">{{learningDraft.startDate || '请选择'}}⌄</view>
          </picker>
        </view>
        <view>
          <text class="field-label">截止日期</text>
          <picker mode="date" value="{{learningDraft.endDate}}" data-field="endDate" bindchange="updateLearningDate">
            <view class="input picker-input">{{learningDraft.endDate || '请选择'}}⌄</view>
          </picker>
        </view>
      </view>

      <text class="field-label">目标总分</text>
      <input class="input" type="number" maxlength="3" value="{{learningDraft.targetTotalScore}}" placeholder="0 至 {{scoreMax}}" data-field="targetTotalScore" bindinput="updateLearningInput" />

      <view class="row between subject-heading">
        <text class="field-label">目标学科（可选）</text>
        <button class="text-button" bindtap="addTargetSubject">添加学科</button>
      </view>
      <view class="subject-target-row" wx:for="{{learningDraft.targetSubjects}}" wx:key="clientId">
        <input class="input subject-name-input" value="{{item.subjectName}}" maxlength="40" placeholder="学科名称" data-index="{{index}}" data-field="subjectName" bindinput="updateTargetSubject" />
        <input class="input subject-score-input" type="number" maxlength="3" value="{{item.targetScore}}" placeholder="目标分" data-index="{{index}}" data-field="targetScore" bindinput="updateTargetSubject" />
        <button class="subject-remove" data-index="{{index}}" bindtap="removeTargetSubject">移除</button>
      </view>

      <text class="field-label">每周任务</text>
      <textarea
        class="input textarea"
        value="{{learningDraft.weeklyTasksText}}"
        maxlength="1000"
        placeholder="每行一项，例如：完成两次错题复盘"
        data-field="weeklyTasksText"
        bindinput="updateLearningInput"
      ></textarea>

      <text class="field-label">状态</text>
      <picker range="{{statusOptions}}" range-key="label" value="{{learningDraft.status === 'not_started' ? 0 : learningDraft.status === 'in_progress' ? 1 : learningDraft.status === 'completed' ? 2 : 3}}" bindchange="updateLearningStatus">
        <view class="input picker-input">{{learningDraft.status === 'not_started' ? '未开始' : learningDraft.status === 'in_progress' ? '进行中' : learningDraft.status === 'completed' ? '已完成' : '已暂停'}}⌄</view>
      </picker>

      <text class="field-label">备注</text>
      <textarea class="input textarea" value="{{learningDraft.notes}}" maxlength="1000" placeholder="可选，请勿填写个人敏感信息" data-field="notes" bindinput="updateLearningInput"></textarea>

      <view wx:if="{{learningError}}" class="input-error">{{learningError}}</view>
      <view class="row action-row">
        <button class="button secondary grow" data-draft="true" bindtap="saveLearningTarget">保存草稿</button>
        <button class="button grow" data-draft="false" bindtap="saveLearningTarget">{{learningDraft.id ? '保存修改' : '创建目标'}}</button>
      </view>
      <view class="muted tiny draft-note">未点击保存时，当前表单也会作为本机草稿保留。</view>
    </view>

    <view class="row between section-row">
      <view class="section-title">学习目标（{{learningRecords.length}}）</view>
      <button wx:if="{{learningRecords.length > 0}}" class="text-button danger-text" bindtap="clearLearningTargets">清空学习目标</button>
    </view>

    <view wx:if="{{learningRecords.length === 0}}" class="card empty">
      <view class="card-title">暂无学习目标</view>
      <view class="muted small empty-note">创建一个可执行的阶段目标，成绩变化后会自动更新当前差距。</view>
    </view>

    <view class="card learning-record-card" wx:for="{{learningRecords}}" wx:key="id">
      <view class="row between">
        <view class="grow">
          <view class="badge-row">
            <text class="status-badge status-{{item.status}}">{{item.statusLabel}}</text>
            <text wx:if="{{item.isDraft}}" class="draft-badge">草稿</text>
          </view>
          <view class="card-title learning-title">{{item.title}}</view>
        </view>
        <button class="text-button" data-id="{{item.id}}" bindtap="editLearningTarget">编辑</button>
      </view>
      <view class="target-metrics">
        <view class="info-row"><text class="info-label">计划周期</text><text class="info-value">{{item.startDate || '待补充'}} 至 {{item.endDate || '待补充'}}</text></view>
        <view class="info-row"><text class="info-label">目标总分</text><text class="info-value">{{item.totalTargetText}}</text></view>
        <view class="info-row"><text class="info-label">当前成绩</text><text class="info-value">{{item.currentScoreText}}</text></view>
        <view class="info-row"><text class="info-label">当前差距</text><text class="info-value">{{item.totalGapText}}</text></view>
      </view>

      <view wx:if="{{item.targetSubjects.length > 0}}" class="record-block">
        <view class="field-label">学科目标</view>
        <view class="subject-progress-row" wx:for="{{item.targetSubjects}}" wx:key="subjectId" wx:for-item="subject">
          <text>{{subject.subjectName}}</text>
          <text class="muted small">{{subject.currentScoreText}} → {{subject.targetScore}} 分 · {{subject.subjectGapText}}</text>
        </view>
      </view>
      <view wx:if="{{item.weeklyTasks.length > 0}}" class="record-block">
        <view class="field-label">每周任务</view>
        <view class="task-row" wx:for="{{item.weeklyTasks}}" wx:key="*this" wx:for-item="task">· {{task}}</view>
      </view>
      <view wx:if="{{item.notes}}" class="record-block">
        <view class="field-label">备注</view>
        <view class="muted small notes-text">{{item.notes}}</view>
      </view>

      <picker
        range="{{statusOptions}}"
        range-key="label"
        value="{{item.statusIndex}}"
        data-id="{{item.id}}"
        bindchange="onLearningRecordStatusChange"
      >
        <view class="input level-picker">更新状态：{{item.statusLabel}}⌄</view>
      </picker>
      <button class="button danger delete-learning-button" data-id="{{item.id}}" bindtap="deleteLearningTarget">删除学习目标</button>
    </view>
  </block>

  <onboarding-overlay
    visible="{{onboarding.visible}}"
    step="{{onboarding.step}}"
    bind:action="onOnboardingAction"
  />
</view>

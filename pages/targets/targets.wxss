.compact-hero { margin-bottom: 24rpx; }
.section-row { margin-top: 4rpx; }
.records-title { margin: 24rpx 0 18rpx; }
.empty-note { margin-top: 12rpx; }
.empty-button { margin: 24rpx auto 0; width: 320rpx; }
.record-level {
  display: inline-flex;
  margin-bottom: 10rpx;
  padding: 7rpx 14rpx;
  color: #0f766e;
  background: #e7f6f3;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.detail-button { margin-top: 20rpx; }
.target-boundary { margin-top: 30rpx; border-left: 8rpx solid #f59e0b; }
.target-boundary-text { margin: 10rpx 0 6rpx; }
.target-search-card { margin-bottom: 24rpx; }
.target-search-input { margin-top: 18rpx; }
.target-search-result {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef2f1;
}
.target-search-result:last-child { border-bottom: none; }
.target-search-result:active { background: #f0f8f6; }
.search-empty { padding-top: 20rpx; text-align: center; }
.target-metrics { margin-top: 18rpx; }
.level-picker {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  color: #0f766e;
  font-weight: 600;
}
.segment-control { display: grid; grid-template-columns: 1fr 1fr; gap: 8rpx; margin-bottom: 24rpx; padding: 8rpx; background: #e7efed; border-radius: 18rpx; }
.segment { padding: 18rpx; color: #64748b; text-align: center; border-radius: 14rpx; }
.segment.active { color: #0f766e; background: #ffffff; font-weight: 700; box-shadow: 0 4rpx 14rpx rgba(15, 118, 110, 0.1); }
.learning-form .field-label { display: block; margin: 18rpx 0 10rpx; }
.learning-note { box-sizing: border-box; width: 100%; min-height: 150rpx; }
.learning-record-note { margin-top: 16rpx; }

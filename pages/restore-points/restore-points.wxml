<view class="page">
  <view class="card intro">
    <view class="card-title">本机安全恢复点</view>
    <view class="muted small">只保存用户本地数据，不包含学校、分数线或账号信息。最多保留 10 个。</view>
    <button class="button" disabled="{{operating}}" bindtap="createManual">{{operating ? '处理中…' : '为当前档案创建恢复点'}}</button>
  </view>

  <view wx:if="{{loading}}" class="state-card">正在读取恢复点…</view>
  <view wx:elif="{{errorMessage}}" class="state-card error">{{errorMessage}}</view>
  <view wx:elif="{{!points.length}}" class="state-card">暂无恢复点。导入、修复或清除数据前会自动创建。</view>

  <view wx:for="{{points}}" wx:key="id" class="card point-card">
    <view class="point-heading"><text class="card-title">{{item.reasonLabel}}</text><text class="muted small">{{item.createdAtLabel}}</text></view>
    <view class="muted small">{{item.scopeLabel}} · 备份 v{{item.backupFormatVersion}} · Schema v{{item.storageSchemaVersion}}</view>
    <view class="summary-grid">
      <text>成绩 {{item.summary.scoreRecordCount}}</text>
      <text>目标 {{item.summary.targetSchoolCount}}</text>
      <text>阶段目标 {{item.summary.stageGoalCount}}</text>
      <text>任务 {{item.summary.learningTaskCount}}</text>
    </view>
    <view class="actions">
      <button size="mini" disabled="{{operating}}" data-id="{{item.id}}" bindtap="restorePoint">恢复</button>
      <button size="mini" class="danger-outline" disabled="{{operating}}" data-id="{{item.id}}" bindtap="deletePoint">删除</button>
    </view>
  </view>

  <button wx:if="{{points.length}}" class="button danger" disabled="{{operating}}" bindtap="clearAll">清除全部恢复点</button>
</view>

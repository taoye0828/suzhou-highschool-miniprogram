.intro { margin-bottom: 24rpx; }
.point-card { margin-bottom: 20rpx; }
.point-heading { display: flex; justify-content: space-between; gap: 16rpx; align-items: baseline; }
.summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx 20rpx; margin: 18rpx 0; font-size: 26rpx; }
.actions { display: flex; gap: 16rpx; justify-content: flex-end; }
.state-card { padding: 48rpx 28rpx; text-align: center; color: #667085; background: #fff; border-radius: 20rpx; margin-bottom: 24rpx; }
.state-card.error { color: #b42318; }
.danger-outline { color: #b42318; border-color: #fda29b; }

.compact-hero { margin-bottom: 24rpx; }
.input-card { margin-top: 24rpx; }
.picker-input { display: flex; align-items: center; color: #334155; }
.input-error { margin-top: 14rpx; color: #b42318; font-size: 24rpx; }
.save-button { margin-top: 24rpx; }
.section-row { margin-top: 4rpx; }
.records-title { margin: 24rpx 0 18rpx; }
.chart-card { overflow: hidden; }
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}
.stat-item { padding: 18rpx 10rpx; background: #f1f8f6; border-radius: 14rpx; text-align: center; }
.stat-value { margin-top: 6rpx; color: #0f766e; font-size: 28rpx; font-weight: 700; }
.trend-canvas { width: 100%; height: 280rpx; margin-top: 22rpx; background: #f8fbfa; border-radius: 14rpx; }
.chart-label-layer { position: relative; width: 100%; height: 92rpx; margin-top: 8rpx; }
.chart-label-item {
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  color: #334155;
  font-size: 20rpx;
  text-align: center;
}
.chart-exam-name {
  display: -webkit-box;
  overflow: hidden;
  line-height: 26rpx;
  text-overflow: ellipsis;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.chart-date {
  overflow: hidden;
  margin-top: 4rpx;
  color: #94a3b8;
  font-size: 19rpx;
  text-overflow: clip;
  white-space: nowrap;
}
.change-card { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; padding: 18rpx; background: #f8fafc; border-radius: 14rpx; }
.change-route { color: #334155; font-weight: 650; }
.change-value { flex-shrink: 0; font-weight: 700; }
.change-value.up { color: #0f766e; }
.change-value.down { color: #b42318; }
.change-value.flat { color: #64748b; }
.chart-note { margin-top: 14rpx; }
.record-date { margin-top: 8rpx; }
.disclaimer-card { margin-top: 34rpx; border-left: 8rpx solid #f59e0b; }
.disclaimer-text { margin-top: 10rpx; }

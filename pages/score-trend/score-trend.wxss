.compact-hero { margin-bottom: 24rpx; }
.input-card { margin-top: 24rpx; }
.picker-input { display: flex; align-items: center; color: #334155; }
.input-error { margin-top: 14rpx; color: #b42318; font-size: 24rpx; }
.save-button { margin-top: 24rpx; }
.section-row { margin-top: 4rpx; }
.records-title { margin: 24rpx 0 18rpx; }
.chart-card { overflow: hidden; }
.chart-scroll { width: 100%; margin-top: 24rpx; }
.chart {
  display: flex;
  align-items: flex-end;
  gap: 18rpx;
  min-width: 100%;
  height: 360rpx;
}
.chart-column {
  display: flex;
  flex: 0 0 92rpx;
  flex-direction: column;
  align-items: center;
  height: 100%;
}
.chart-score { height: 38rpx; color: #0f766e; font-size: 22rpx; font-weight: 600; }
.bar-track {
  position: relative;
  width: 42rpx;
  height: 220rpx;
  overflow: hidden;
  background: #edf2f1;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}
.bar {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, #14b8a6, #0f766e);
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}
.chart-label {
  width: 92rpx;
  margin-top: 10rpx;
  overflow: hidden;
  color: #334155;
  font-size: 20rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.chart-date { margin-top: 4rpx; color: #94a3b8; font-size: 19rpx; }
.chart-note { margin-top: 14rpx; }
.record-date { margin-top: 8rpx; }
.disclaimer-card { margin-top: 34rpx; border-left: 8rpx solid #f59e0b; }
.disclaimer-text { margin-top: 10rpx; }

.segments { display: flex; margin-bottom: 24rpx; padding: 6rpx; background: #e8efed; border-radius: 18rpx; }
.segment { flex: 1; min-height: 68rpx; margin: 0; color: #64748b; background: transparent; font-size: 27rpx; }
.segment.active { color: #0f766e; background: #ffffff; font-weight: 700; }
.picker { display: flex; align-items: center; }
.record-score, .stat-value { color: #0f766e; font-size: 34rpx; font-weight: 700; }
.stats { display: flex; gap: 12rpx; }
.stat { flex: 1; padding: 20rpx 12rpx; text-align: center; }
.stat-value { margin-top: 8rpx; font-size: 28rpx; }
.chart-card { padding: 18rpx 0 26rpx; overflow: hidden; }
.chart-scroll { width: 100%; }
.chart-content { position: relative; height: 430rpx; }
.trend-canvas { height: 300rpx; }
.axis-labels { position: relative; height: 120rpx; }
.axis-label { position: absolute; width: 138rpx; margin-left: -69rpx; text-align: center; font-size: 21rpx; line-height: 1.4; }

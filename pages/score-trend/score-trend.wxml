<view class="page">
  <view wx:if="{{loading}}" class="card muted">正在读取当前档案的成绩数据…</view>
  <view wx:if="{{pageError}}" class="input-error">{{pageError}}</view>
  <view class="segment-control">
    <view
      class="segment {{activeSegment === 'records' ? 'active' : ''}}"
      data-segment="records"
      bindtap="selectSegment"
    >记录</view>
    <view
      class="segment {{activeSegment === 'trend' ? 'active' : ''}}"
      data-segment="trend"
      bindtap="selectSegment"
    >趋势</view>
    <view
      class="segment {{activeSegment === 'review' ? 'active' : ''}}"
      data-segment="review"
      bindtap="selectSegment"
    >复盘</view>
  </view>

  <view class="profile-strip">
    <text>{{activeProfileName}}</text>
    <text class="profile-strip-meta">当前档案 · 本机数据</text>
  </view>

  <block wx:if="{{activeSegment === 'records'}}">
    <view class="card input-card onboarding-score-form">
      <view class="row between form-heading">
        <view>
          <view class="card-title">{{recordFormModeText}}</view>
          <view wx:if="{{templateSourceId}}" class="muted small form-hint">
            已清空原成绩和排名，保存时会生成一条新记录。
          </view>
        </view>
        <button
          wx:if="{{editingRecordId || templateSourceId}}"
          class="button ghost small-button"
          bindtap="cancelRecordEdit"
        >取消</button>
      </view>

      <block wx:if="{{!editingRecordId}}">
        <text class="field-label">考试模板（可选）</text>
        <picker
          range="{{examTemplateOptions}}"
          range-key="label"
          value="{{examTemplateIndex}}"
          bindchange="onExamTemplateChange"
        >
          <view class="input picker-input">{{examTemplateOptions[examTemplateIndex].label}}⌄</view>
        </picker>
      </block>
      <view class="row between scheme-heading">
        <text class="field-label">分值方案</text>
        <button class="text-button" bindtap="openExamSettings">管理模板与方案</button>
      </view>
      <picker
        range="{{scoreSchemeOptions}}"
        range-key="label"
        value="{{scoreSchemeIndex}}"
        bindchange="onScoreSchemeChange"
      >
        <view class="input picker-input">{{scoreSchemeOptions[scoreSchemeIndex].label}}⌄</view>
      </picker>
      <view class="muted small scheme-note">保存后会保留当次方案快照，以后修改方案不会改变历史考试。</view>
      <text class="field-label">考试类型</text>
      <picker
        range="{{examTypeOptions}}"
        range-key="label"
        value="{{examTypeIndex}}"
        bindchange="onExamTypeChange"
      >
        <view class="input picker-input">{{examTypeOptions[examTypeIndex].label}}⌄</view>
      </picker>

      <text class="field-label">考试日期</text>
      <picker mode="date" value="{{selectedDate}}" start="2020-01-01" end="2100-12-31" bindchange="onDateChange">
        <view class="input picker-input">{{selectedDate}}⌄</view>
      </picker>
      <text class="field-label">考试名称</text>
      <input
        class="input"
        maxlength="40"
        value="{{examName}}"
        placeholder="例如：2026-09 月考"
        bindinput="onExamNameInput"
      />
      <text class="field-label">总分（满分 {{scoreMax}}）</text>
      <input
        class="input"
        type="number"
        maxlength="3"
        value="{{scoreInput}}"
        placeholder="请输入 0 至 {{scoreMax}} 的整数"
        bindinput="onScoreInput"
      />

      <button class="detail-toggle" bindtap="toggleRecordDetails">
        {{showRecordDetails ? '收起学科、排名和复盘' : '填写学科、排名和复盘（可选）'}}
      </button>

      <view wx:if="{{showRecordDetails}}" class="advanced-fields">
        <view wx:if="{{formEnableSubjectScores}}" class="subsection-title">档案学科配置</view>
        <view wx:if="{{formEnableSubjectScores}}" class="muted small subject-config-help">
          所选分值方案已有学科规则时优先使用方案；档案配置用于无学科规则的自定义考试。
        </view>
        <view
          wx:for="{{subjectConfigs}}"
          wx:if="{{formEnableSubjectScores}}"
          wx:key="subjectId"
          class="subject-config-row"
        >
          <view class="grow">
            <view>{{item.subjectName}} · 满分 {{item.maxScore}} 分</view>
            <view class="muted small">{{item.includedInTotal ? '计入总分' : '不计入总分'}}</view>
          </view>
          <button
            class="button ghost small-button config-action"
            data-subject-id="{{item.subjectId}}"
            bindtap="editSubjectConfig"
          >编辑</button>
          <button
            class="button danger small-button config-action"
            data-subject-id="{{item.subjectId}}"
            bindtap="deleteSubjectConfig"
          >删除</button>
        </view>
        <view wx:if="{{formEnableSubjectScores && subjectConfigs.length === 0}}" class="muted small subject-empty-note">
          暂无学科配置。可以继续只记录总分，也可以在下方添加自己的科目。
        </view>
        <view wx:if="{{formEnableSubjectScores}}" class="subject-config-form">
          <view class="two-column-fields">
            <view>
              <text class="field-label">学科名称</text>
              <input
                class="input"
                maxlength="40"
                value="{{subjectConfigNameInput}}"
                placeholder="由你填写"
                data-field="subjectName"
                bindinput="onSubjectConfigInput"
              />
            </view>
            <view>
              <text class="field-label">学科满分</text>
              <input
                class="input"
                type="number"
                maxlength="3"
                value="{{subjectConfigMaxInput}}"
                placeholder="1 至 740"
                data-field="maxScore"
                bindinput="onSubjectConfigInput"
              />
            </view>
          </view>
          <view class="included-switch row between">
            <view>
              <view>计入总分</view>
              <view class="muted small">仅记录配置，不自动重算总分。</view>
            </view>
            <switch
              color="#0f766e"
              checked="{{subjectConfigIncludedInTotal}}"
              bindchange="onSubjectIncludedChange"
            />
          </view>
          <view wx:if="{{subjectConfigError}}" class="input-error">{{subjectConfigError}}</view>
          <view class="subject-config-actions">
            <button class="button secondary small-button" bindtap="saveSubjectConfig">{{subjectConfigSaveText}}</button>
            <button
              wx:if="{{editingSubjectConfigId}}"
              class="button ghost small-button"
              bindtap="cancelSubjectConfigEdit"
            >取消编辑</button>
          </view>
        </view>

        <view wx:if="{{formEnableSubjectScores}}" class="subsection-title exam-subject-title">本次考试学科成绩（可选）</view>
        <view wx:if="{{formEnableSubjectScores && formSubjectScores.length === 0}}" class="muted small subject-empty-note">
          当前方案和档案都没有学科规则，可以只记录总分。
        </view>
        <view
          wx:for="{{formSubjectScores}}"
          wx:if="{{formEnableSubjectScores}}"
          wx:key="subjectId"
          class="subject-input-row"
        >
          <view class="subject-input-label">
            <text>{{item.subjectName}}</text>
            <text class="muted small">满分 {{item.maxScoreText}}</text>
          </view>
          <input
            class="input subject-score-input"
            type="number"
            maxlength="3"
            value="{{item.scoreInput}}"
            placeholder="可留空"
            data-subject-id="{{item.subjectId}}"
            bindinput="onSubjectScoreInput"
          />
        </view>

        <view wx:if="{{formEnableRank}}" class="two-column-fields">
          <view>
            <text class="field-label">班级排名（可选）</text>
            <input
              class="input"
              type="number"
              maxlength="6"
              value="{{classRankInput}}"
              placeholder="正整数"
              data-field="classRankInput"
              bindinput="onRankInput"
            />
          </view>
          <view>
            <text class="field-label">年级排名（可选）</text>
            <input
              class="input"
              type="number"
              maxlength="6"
              value="{{gradeRankInput}}"
              placeholder="正整数"
              data-field="gradeRankInput"
              bindinput="onRankInput"
            />
          </view>
        </view>

        <text wx:if="{{formEnableReview}}" class="field-label">进步原因（可选）</text>
        <textarea
          wx:if="{{formEnableReview}}"
          class="input textarea review-textarea"
          maxlength="1000"
          value="{{improvementNotes}}"
          placeholder="记录你自己确认的有效做法"
          data-field="improvementNotes"
          bindinput="onReviewNoteInput"
        ></textarea>
        <text wx:if="{{formEnableReview}}" class="field-label">失分原因（可选）</text>
        <textarea
          wx:if="{{formEnableReview}}"
          class="input textarea review-textarea"
          maxlength="1000"
          value="{{lossNotes}}"
          placeholder="记录错题、知识点或时间分配问题"
          data-field="lossNotes"
          bindinput="onReviewNoteInput"
        ></textarea>
        <text wx:if="{{formEnableReview}}" class="field-label">下次改进重点（可选）</text>
        <textarea
          wx:if="{{formEnableReview}}"
          class="input textarea review-textarea"
          maxlength="1000"
          value="{{nextActions}}"
          placeholder="写下可执行的下一步"
          data-field="nextActions"
          bindinput="onReviewNoteInput"
        ></textarea>
        <text wx:if="{{formEnableReview}}" class="field-label">备注（可选）</text>
        <textarea
          wx:if="{{formEnableReview}}"
          class="input textarea review-textarea"
          maxlength="1000"
          value="{{notes}}"
          placeholder="仅保存在本机"
          data-field="notes"
          bindinput="onReviewNoteInput"
        ></textarea>
      </view>

      <view wx:if="{{inputError}}" class="input-error">{{inputError}}</view>
      <button class="button save-button" disabled="{{saving}}" loading="{{saving}}" bindtap="saveRecord">{{recordSaveButtonText}}</button>
    </view>

    <view class="card filter-card">
      <view class="card-title">查找考试</view>
      <input
        class="input filter-input"
        value="{{recordKeyword}}"
        placeholder="按考试名称搜索"
        bindinput="onRecordKeywordInput"
      />
      <view class="filter-date-row">
        <picker
          class="grow"
          mode="date"
          value="{{recordDateFilter}}"
          start="2020-01-01"
          end="2100-12-31"
          bindchange="onFilterDateChange"
        >
          <view class="input picker-input">
            {{recordDateFilter || '选择考试日期'}}
          </view>
        </picker>
        <button class="button ghost small-button filter-clear" bindtap="clearRecordFilters">清除筛选</button>
      </view>
      <view class="muted small filter-result">
        当前显示 {{filteredRecordCount}} 条，共 {{records.length}} 条。
      </view>
    </view>

    <view class="row between section-row">
      <view class="section-title records-title">成绩记录（{{records.length}} / {{maxRecords}}）</view>
      <button wx:if="{{records.length > 0}}" class="button danger small-button" bindtap="clearAllRecords">清空全部</button>
    </view>

    <view wx:if="{{records.length === 0}}" class="card empty">
      <view class="card-title">暂无成绩记录</view>
      <view class="muted small">填写考试日期、名称和总分后即可保存在当前学生档案。</view>
    </view>

    <view wx:elif="{{filteredRecords.length === 0}}" class="card empty">
      <view class="card-title">没有符合筛选条件的考试</view>
      <view class="muted small">可修改考试名称或清除日期筛选。</view>
    </view>

    <view class="card record-card" wx:for="{{filteredRecords}}" wx:key="id">
      <view class="row between record-heading">
        <view class="grow">
          <view class="card-title">{{item.examName}} · {{item.score}} 分</view>
          <view class="muted small record-date">{{item.examDate}}</view>
          <view class="muted small record-date">{{item.examTypeLabel}} · 满分 {{item.totalMaxScore}} · 得分率 {{item.scoreRateText}}</view>
        </view>
        <view wx:if="{{item.hasReview}}" class="review-badge">有复盘</view>
      </view>
      <view class="record-actions">
        <button class="button secondary small-button" data-id="{{item.id}}" bindtap="toggleRecordCard">
          {{item.isExpanded ? '收起详情' : '查看详情'}}
        </button>
        <button class="button ghost small-button" data-id="{{item.id}}" bindtap="editRecord">编辑</button>
        <button class="button ghost small-button" data-id="{{item.id}}" bindtap="copyRecordTemplate">复制模板</button>
        <button class="button danger small-button" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
      </view>

      <view wx:if="{{item.isExpanded}}" class="record-detail">
        <view class="review-line">
          <view class="muted small">历史分值方案</view>
          <view>{{item.scoreSchemeName}} · {{item.metricType === 'full_total' ? '完整总分' : item.metricType === 'partial_total' ? '部分科目总分' : '单科'}}</view>
          <view class="muted small">{{item.eligibility.message}}</view>
        </view>
        <view class="detail-grid">
          <view class="detail-cell">
            <view class="muted small">班级排名</view>
            <view>{{item.classRankText}}</view>
          </view>
          <view class="detail-cell">
            <view class="muted small">年级排名</view>
            <view>{{item.gradeRankText}}</view>
          </view>
        </view>
        <view wx:if="{{item.subjectScores.length > 0}}" class="record-subjects">
          <view
            wx:for="{{item.subjectScores}}"
            wx:for-item="subject"
            wx:key="subjectId"
            class="record-subject-row"
          >
            <text>{{subject.subjectName}}</text>
            <text>{{subject.score}}{{subject.maxScoreText}}</text>
          </view>
        </view>
        <view wx:if="{{item.improvementNotes}}" class="review-line">
          <view class="muted small">进步原因</view>
          <view>{{item.improvementNotes}}</view>
        </view>
        <view wx:if="{{item.lossNotes}}" class="review-line">
          <view class="muted small">失分原因</view>
          <view>{{item.lossNotes}}</view>
        </view>
        <view wx:if="{{item.nextActions}}" class="review-line">
          <view class="muted small">下次改进重点</view>
          <view>{{item.nextActions}}</view>
        </view>
        <view wx:if="{{item.notes}}" class="review-line">
          <view class="muted small">备注</view>
          <view>{{item.notes}}</view>
        </view>
        <view wx:if="{{!item.hasReview}}" class="muted small">该考试尚未填写学科、排名或复盘内容。</view>
      </view>
    </view>
  </block>

  <block wx:if="{{activeSegment === 'trend'}}">
    <view class="onboarding-score-trend">
      <view class="metric-toggle card">
        <button
          class="metric-button {{trendMetric === 'raw' ? 'active' : ''}}"
          data-metric="raw"
          bindtap="onTrendMetricChange"
        >总分原始分</button>
        <button
          class="metric-button {{trendMetric === 'rate' ? 'active' : ''}}"
          data-metric="rate"
          bindtap="onTrendMetricChange"
        >总分得分率</button>
      </view>
      <view wx:if="{{visibleRecords.length === 0}}" class="card empty">
        <view class="card-title">暂无趋势数据</view>
        <view class="muted small">先在“记录”中保存一场考试，再查看总分和学科变化。</view>
      </view>

      <view wx:if="{{visibleRecords.length > 0}}" class="card chart-card">
        <view class="card-title">{{trendTitle}} · 最近 {{visibleRecords.length}} 次</view>
        <view class="muted small trend-count-note">共 {{records.length}} 条记录，图中最多展示最近 10 条。</view>
        <view class="stats-grid">
          <view class="stat-item"><view class="muted small">最高分</view><view class="stat-value">{{highestText}}</view></view>
          <view class="stat-item"><view class="muted small">最低分</view><view class="stat-value">{{lowestText}}</view></view>
          <view class="stat-item"><view class="muted small">平均分</view><view class="stat-value">{{averageText}}</view></view>
        </view>
        <canvas id="scoreTrendChart" canvas-id="scoreTrendChart" class="trend-canvas" width="{{canvasWidth}}" height="280"></canvas>
        <view class="chart-label-layer">
          <view
            wx:for="{{visibleTrendPoints}}"
            wx:key="id"
            class="chart-label-item"
            style="{{item.labelStyle}}"
          >
            <view class="chart-exam-name">{{item.examName}}</view>
            <view class="chart-date">{{item.displayDate}}</view>
          </view>
        </view>
        <view class="change-card">
          <view class="change-route">{{changeText}}</view>
          <view class="change-value {{changeClass}}">{{changeValueText}}</view>
        </view>
      </view>

      <view class="card subject-trend-card">
        <view class="row between">
          <view class="card-title">学科趋势</view>
          <view class="subject-metric-toggle">
            <button class="text-button {{subjectMetric === 'raw' ? 'active-text' : ''}}" data-metric="raw" bindtap="onSubjectMetricChange">原始分</button>
            <button class="text-button {{subjectMetric === 'rate' ? 'active-text' : ''}}" data-metric="rate" bindtap="onSubjectMetricChange">得分率</button>
          </view>
        </view>
        <view wx:if="{{subjectOptions.length === 0}}" class="muted small subject-empty-state">
          当前记录只有总分，或尚未填写有效学科成绩。总分记录仍然有效；本页不会自动补造科目配置。
        </view>
        <block wx:else>
          <picker
            range="{{subjectOptions}}"
            range-key="label"
            value="{{selectedSubjectIndex}}"
            bindchange="onSubjectChange"
          >
            <view class="input picker-input subject-picker">{{subjectOptions[selectedSubjectIndex].label}}⌄</view>
          </picker>
          <view class="muted small subject-max-note">{{selectedSubjectMaxText}}</view>
          <view class="stats-grid subject-stats">
            <view class="stat-item"><view class="muted small">最高分</view><view class="stat-value">{{subjectHighestText}}</view></view>
            <view class="stat-item"><view class="muted small">最低分</view><view class="stat-value">{{subjectLowestText}}</view></view>
            <view class="stat-item"><view class="muted small">平均分</view><view class="stat-value">{{subjectAverageText}}</view></view>
          </view>
          <view class="subject-summary-grid">
            <view class="summary-row"><text class="muted">最近变化</text><text>{{subjectChangeText}}</text></view>
            <view class="summary-row"><text class="muted">最近三次平均</text><text>{{subjectRecentThreeText}}</text></view>
            <view class="summary-row"><text class="muted">个人历史平均</text><text>{{subjectHistoryAverageText}}</text></view>
          </view>
          <scroll-view class="subject-series-scroll" scroll-x enable-flex>
            <view class="subject-series">
              <view
                wx:for="{{subjectTrendItems}}"
                wx:key="recordId"
                class="subject-series-item"
              >
                <view class="subject-series-score">{{item.scoreText}}</view>
                <view class="subject-series-delta {{item.deltaClass}}">{{item.deltaText}}</view>
                <view class="subject-series-name">{{item.examName}}</view>
                <view class="muted subject-series-date">{{item.displayDate}}</view>
              </view>
            </view>
          </scroll-view>
          <view class="muted small subject-series-note">按日期、创建时间和记录标识稳定排序，最多展示最近 10 次。</view>
          <view class="analysis-box">
            <view class="analysis-title">确定性分析</view>
            <view class="analysis-line">{{subjectVolatilityText}}</view>
            <view
              wx:for="{{subjectConclusions}}"
              wx:key="code"
              class="analysis-line {{item.severity}}"
            >{{item.text}}</view>
          </view>
        </block>
      </view>
    </view>
  </block>

  <block wx:if="{{activeSegment === 'review'}}">
    <view wx:if="{{reviewOptions.length === 0}}" class="card empty">
      <view class="card-title">暂无可复盘的考试</view>
      <view class="muted small">先在“记录”中新增一场考试。</view>
    </view>

    <view wx:if="{{reviewOptions.length > 0}}" class="card review-card">
      <view class="card-title">选择考试并复盘</view>
      <picker
        range="{{reviewOptions}}"
        range-key="label"
        value="{{selectedReviewIndex}}"
        bindchange="onReviewExamChange"
      >
        <view class="input picker-input review-picker">{{reviewOptions[selectedReviewIndex].label}}⌄</view>
      </picker>
      <view class="selected-review-heading">
        <view class="card-title">{{selectedReviewExamName}}</view>
        <view class="muted small">{{selectedReviewExamDate}}</view>
      </view>

      <text class="field-label">总分</text>
      <input
        class="input"
        type="number"
        maxlength="3"
        value="{{reviewDraft.totalScore}}"
        placeholder="0 至 {{reviewScoreMax}}"
        data-field="totalScore"
        bindinput="onReviewInput"
      />

      <view class="subsection-title review-subject-title">学科成绩（可选）</view>
      <view wx:if="{{reviewSubjectScores.length === 0}}" class="muted small subject-empty-note">
        该考试没有可编辑的学科字段，可只复盘总分和失分情况。
      </view>
      <view
        wx:for="{{reviewSubjectScores}}"
        wx:key="subjectId"
        class="subject-input-row"
      >
        <view class="subject-input-label">
          <text>{{item.subjectName}}</text>
          <text class="muted small">满分 {{item.maxScoreText}}</text>
        </view>
        <input
          class="input subject-score-input"
          type="number"
          maxlength="3"
          value="{{item.scoreInput}}"
          placeholder="可留空"
          data-subject-id="{{item.subjectId}}"
          bindinput="onReviewSubjectScoreInput"
        />
      </view>

      <view class="two-column-fields">
        <view>
          <text class="field-label">班级排名（可选）</text>
          <input
            class="input"
            type="number"
            maxlength="6"
            value="{{reviewDraft.classRank}}"
            placeholder="正整数"
            data-field="classRank"
            bindinput="onReviewInput"
          />
        </view>
        <view>
          <text class="field-label">年级排名（可选）</text>
          <input
            class="input"
            type="number"
            maxlength="6"
            value="{{reviewDraft.gradeRank}}"
            placeholder="正整数"
            data-field="gradeRank"
            bindinput="onReviewInput"
          />
        </view>
      </view>

      <text class="field-label">进步原因（可选）</text>
      <textarea
        class="input textarea review-textarea"
        maxlength="1000"
        value="{{reviewDraft.improvementNotes}}"
        placeholder="只记录你确认过的原因"
        data-field="improvementNotes"
        bindinput="onReviewInput"
      ></textarea>
      <text class="field-label">失分原因（可选）</text>
      <textarea
        class="input textarea review-textarea"
        maxlength="1000"
        value="{{reviewDraft.lossNotes}}"
        placeholder="例如：知识点、审题或时间分配"
        data-field="lossNotes"
        bindinput="onReviewInput"
      ></textarea>
      <text class="field-label">下次改进重点（可选）</text>
      <textarea
        class="input textarea review-textarea"
        maxlength="1000"
        value="{{reviewDraft.nextActions}}"
        placeholder="写下下一场考试前可执行的动作"
        data-field="nextActions"
        bindinput="onReviewInput"
      ></textarea>
      <text class="field-label">备注（可选）</text>
      <textarea
        class="input textarea review-textarea"
        maxlength="1000"
        value="{{reviewDraft.notes}}"
        placeholder="仅保存在本机"
        data-field="notes"
        bindinput="onReviewInput"
      ></textarea>
      <view wx:if="{{reviewError}}" class="input-error">{{reviewError}}</view>
      <button class="button review-save-button" disabled="{{saving}}" loading="{{saving}}" bindtap="saveReview">保存考试复盘</button>

      <view class="subsection-title review-subject-title">按学科记录失分原因</view>
      <view class="muted small">只记录你确认过的事实，不推断心理、能力或其他原因。</view>
      <view class="two-column-fields">
        <picker
          range="{{lossSubjectOptions}}"
          range-key="subjectName"
          value="{{lossSubjectIndex}}"
          bindchange="onLossSubjectChange"
        >
          <view class="input picker-input">{{lossSubjectOptions[lossSubjectIndex].subjectName}}⌄</view>
        </picker>
        <picker
          range="{{lossReasonTypes}}"
          value="{{lossReasonTypeIndex}}"
          bindchange="onLossReasonTypeChange"
        >
          <view class="input picker-input">{{lossReasonTypes[lossReasonTypeIndex]}}⌄</view>
        </picker>
      </view>
      <textarea
        class="input textarea review-textarea"
        maxlength="1000"
        value="{{lossDetail}}"
        placeholder="自定义说明（可选）"
        data-field="lossDetail"
        bindinput="onLossInput"
      ></textarea>
      <textarea
        class="input textarea review-textarea"
        maxlength="1000"
        value="{{lossImprovementAction}}"
        placeholder="你准备采取的改进措施（可选）"
        data-field="lossImprovementAction"
        bindinput="onLossInput"
      ></textarea>
      <button class="button secondary" bindtap="addLossReason">添加失分原因</button>

      <view wx:if="{{savedLossReasons.length}}" class="subsection-title">本场失分原因</view>
      <view wx:for="{{savedLossReasons}}" wx:key="id" class="preview-box">
        <view><text class="tag">{{item.subjectName}}</text><text class="tag">{{item.reasonType}}</text></view>
        <view wx:if="{{item.detail}}" class="small">{{item.detail}}</view>
        <view wx:if="{{item.improvementAction}}" class="muted small">改进：{{item.improvementAction}}</view>
        <view class="button-row">
          <button class="button secondary grow" data-id="{{item.id}}" bindtap="createTaskFromLoss">创建学习任务</button>
          <button class="button danger grow" data-id="{{item.id}}" bindtap="deleteLossReason">删除</button>
        </view>
      </view>

      <view wx:if="{{savedLossReasons.length}}" class="subsection-title">创建任务设置</view>
      <view wx:if="{{savedLossReasons.length}}" class="two-column-fields">
        <view>
          <text class="field-label">截止日期</text>
          <picker mode="date" value="{{taskDueDate}}" bindchange="onTaskDueDateChange">
            <view class="input picker-input">{{taskDueDate}}⌄</view>
          </picker>
        </view>
        <view>
          <text class="field-label">每周次数</text>
          <input
            class="input"
            type="number"
            value="{{taskWeeklyTarget}}"
            data-field="taskWeeklyTarget"
            bindinput="onLossInput"
          />
        </view>
      </view>
      <picker
        wx:if="{{savedLossReasons.length}}"
        range="{{taskStageGoals}}"
        range-key="title"
        value="{{taskStageGoalIndex}}"
        bindchange="onTaskStageGoalChange"
      >
        <view class="input picker-input">{{taskStageGoals[taskStageGoalIndex].title}}⌄</view>
      </picker>

      <view class="subsection-title">错题记录（不保存图片）</view>
      <view class="muted small">重复出错只在你主动确认后记录；错题和学习任务会在一次保存中建立双向关联。</view>
      <view class="two-column-fields">
        <input class="input" maxlength="80" value="{{mistakeQuestionType}}" data-field="mistakeQuestionType" bindinput="onMistakeInput" placeholder="题型（可选）" />
        <input class="input" maxlength="3" type="number" value="{{mistakeLostScore}}" data-field="mistakeLostScore" bindinput="onMistakeInput" placeholder="失分值" />
      </view>
      <input class="input" maxlength="200" value="{{mistakeKnowledgePoint}}" data-field="mistakeKnowledgePoint" bindinput="onMistakeInput" placeholder="知识点（可选）" />
      <textarea class="input textarea" maxlength="1000" value="{{mistakeDetail}}" data-field="mistakeDetail" bindinput="onMistakeInput" placeholder="错因与题目文字说明（不保存图片）"></textarea>
      <textarea class="input textarea" maxlength="1000" value="{{mistakeImprovementAction}}" data-field="mistakeImprovementAction" bindinput="onMistakeInput" placeholder="改进动作"></textarea>
      <textarea class="input textarea" maxlength="1000" value="{{mistakeNotes}}" data-field="mistakeNotes" bindinput="onMistakeInput" placeholder="备注（可选）"></textarea>
      <view class="switch-row row between"><text>已订正</text><switch checked="{{mistakeCorrected}}" data-field="mistakeCorrected" bindchange="onMistakeSwitch" color="#0f766e" /></view>
      <view class="switch-row row between"><text>我确认这是重复出错</text><switch checked="{{mistakeRepeatedConfirmed}}" data-field="mistakeRepeatedConfirmed" bindchange="onMistakeSwitch" color="#0f766e" /></view>
      <view class="button-row"><button class="button secondary grow" disabled="{{saving}}" bindtap="saveMistake">{{editingMistakeId ? '保存错题修改' : '添加错题'}}</button><button wx:if="{{editingMistakeId}}" class="button ghost grow" disabled="{{saving}}" bindtap="resetMistakeForm">取消</button></view>

      <view wx:for="{{savedMistakes}}" wx:key="id" class="preview-box">
        <view><text class="tag">{{item.subjectName || '总分'}}</text><text class="tag">{{item.reasonType}}</text><text wx:if="{{item.corrected}}" class="tag">已订正</text></view>
        <view class="small">{{item.knowledgePoint || item.questionType || '未填写知识点'}} · 失分 {{item.lostScore}}</view>
        <view wx:if="{{item.repeatedErrorConfirmed}}" class="muted small">用户已确认重复出错</view>
        <view class="muted small">关联任务 {{item.linkedTaskIds.length}} 条</view>
        <view class="button-row"><button class="button secondary grow" data-id="{{item.id}}" bindtap="editMistake">编辑</button><button class="button secondary grow" data-id="{{item.id}}" bindtap="createTaskFromMistake">创建任务</button><button class="button danger grow" data-id="{{item.id}}" bindtap="deleteMistake">删除</button></view>
      </view>

      <view wx:if="{{lossStatistics.total}}" class="subsection-title">失分原因统计</view>
      <view wx:if="{{lossStatistics.total}}" class="muted small">
        共 {{lossStatistics.total}} 条；当前最多：{{lossStatistics.mostFrequent.reasonType}}（{{lossStatistics.mostFrequent.count}} 次）
      </view>
      <view wx:for="{{lossStatistics.types}}" wx:key="reasonType" class="info-row">
        <text>{{item.reasonType}}</text>
        <text>{{item.count}} 次{{item.repeatedInRecentThree ? ' · 最近三次重复' : ''}}</text>
      </view>
    </view>
  </block>

  <onboarding-overlay
    visible="{{onboarding.visible}}"
    step="{{onboarding.step}}"
    bind:action="onOnboardingAction"
  />

</view>

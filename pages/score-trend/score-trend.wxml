<view class="page">
  <view class="segments"><button class="segment {{segment === 'records' ? 'active' : ''}}" data-segment="records" bindtap="selectSegment">记录</button><button class="segment {{segment === 'trend' ? 'active' : ''}}" data-segment="trend" bindtap="selectSegment">趋势</button></view>

  <block wx:if="{{segment === 'records'}}">
    <view class="card">
      <view class="card-title">{{form.id ? '编辑考试成绩' : '记录考试成绩'}}</view>
      <text class="field-label">考试名称</text>
      <input class="input" maxlength="40" value="{{form.examName}}" placeholder="例如：期中考试" data-field="examName" bindinput="onFormInput" />
      <text class="field-label">考试日期</text>
      <picker mode="date" value="{{form.examDate}}" bindchange="onDateChange"><view class="input picker">{{form.examDate}}⌄</view></picker>
      <text class="field-label">总分（0—740）</text>
      <input class="input" type="digit" maxlength="3" value="{{form.totalScore}}" placeholder="请输入总分" data-field="totalScore" bindinput="onFormInput" />
      <view class="button-row"><button wx:if="{{form.id}}" class="button secondary" bindtap="resetForm">取消编辑</button><button class="button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveRecord">保存</button></view>
    </view>

    <view class="section-title">考试记录</view>
    <view wx:if="{{recordCards.length === 0}}" class="card empty">还没有考试记录。</view>
    <view class="card" wx:for="{{recordCards}}" wx:key="id">
      <view class="row between"><view><view class="card-title">{{item.examName}}</view><view class="muted small">{{item.examDate}}</view></view><view class="record-score">{{item.totalScore}} 分</view></view>
      <view class="button-row"><button class="button secondary small-button" data-id="{{item.id}}" bindtap="editRecord">编辑</button><button class="button danger small-button" data-id="{{item.id}}" bindtap="deleteRecord">删除</button></view>
    </view>
  </block>

  <block wx:else>
    <view class="stats">
      <view class="card stat"><view class="muted small">最近总分</view><view class="stat-value">{{statistics.latest}}</view></view>
      <view class="card stat"><view class="muted small">最高分</view><view class="stat-value">{{statistics.highest}}</view></view>
      <view class="card stat"><view class="muted small">平均分</view><view class="stat-value">{{statistics.average}}</view></view>
    </view>
    <view wx:if="{{trendItems.length}}" class="card chart-card">
      <scroll-view scroll-x class="chart-scroll">
        <view class="chart-content" style="width: {{chartWidth}}px">
          <canvas type="2d" id="trendCanvas" class="trend-canvas" style="width: {{chartWidth}}px"></canvas>
          <view class="axis-labels">
            <view class="axis-label" wx:for="{{trendItems}}" wx:key="id" style="left: {{item.leftPercent}}%">
              <view>{{item.examName}}</view><view class="muted">{{item.shortDate}}</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view wx:else class="card empty">记录一次考试总分后，这里会显示最近总分趋势。</view>
  </block>
</view>

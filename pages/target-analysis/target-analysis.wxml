<view class="page">
  <view class="card input-card">
    <text class="field-label">当前成绩</text>
    <input
      class="input onboarding-score-input"
      type="number"
      maxlength="3"
      value="{{scoreInput}}"
      placeholder="请输入 0 至 {{scoreMax}} 的整数"
      bindinput="onScoreInput"
    />
    <text class="field-label">筛选分析学校（可选）</text>
    <input
      class="input"
      value="{{schoolKeyword}}"
      placeholder="输入学校名称或简称，如：南航"
      bindinput="onSchoolKeywordInput"
    />
    <text class="field-label">目标考试年份</text>
    <picker range="{{targetYears}}" value="{{targetYearIndex}}" bindchange="onTargetYearChange">
      <view class="input picker-input">{{targetYears[targetYearIndex]}} 年⌄</view>
    </picker>
    <view wx:if="{{inputError}}" class="input-error">{{inputError}}</view>
    <button class="button analyze-button onboarding-analyze-button" bindtap="analyze">开始分析</button>
  </view>

  <block wx:if="{{hasAnalyzed}}">
    <view class="card result-actions">
      <view class="muted small">结果根据历史公开数据整理，仅供目标规划参考。</view>
      <view class="row result-action-buttons">
        <button class="button secondary grow" bindtap="saveCurrentScore">{{scoreSaved ? '成绩已保存' : '保存本次成绩'}}</button>
        <button class="button secondary grow onboarding-trend-entry" bindtap="openScoreTrend">查看成绩趋势</button>
      </view>
    </view>

    <view wx:for="{{sections}}" wx:key="value" wx:for-item="section" class="analysis-section">
      <view class="section-title section-heading">{{section.label}}（{{section.results.length}}）</view>
      <view class="muted small section-description">{{section.description}}</view>
      <view wx:if="{{section.results.length === 0}}" class="card empty compact-empty">
        当前没有符合该区间且已收录历史分数线的学校。
      </view>
      <view
        wx:for="{{section.results}}"
        wx:key="schoolId"
        wx:for-item="result"
        class="card result-card"
      >
        <view class="row between" data-id="{{result.schoolId}}" bindtap="openDetail">
          <view class="card-title grow">{{result.schoolName}}</view>
          <view class="list-arrow">›</view>
        </view>
        <view wx:if="{{result.isTargetSchool}}" class="target-link-badge">
          已加入目标 · {{result.targetLevelLabel}}
        </view>
        <view class="info-row"><text class="info-label">地区</text><text class="info-value">{{result.district}}</text></view>
        <view class="info-row"><text class="info-label">类型</text><text class="info-value">{{result.schoolType}}</text></view>
        <view class="info-row"><text class="info-label">历史参考分</text><text class="info-value">{{result.schoolScore}} 分（{{result.year}} 年）</text></view>
        <view class="info-row"><text class="info-label">当前成绩</text><text class="info-value">{{result.userScore}} 分</text></view>
        <view class="info-row"><text class="info-label">分差</text><text class="info-value">{{result.differenceText}}</text></view>
        <view class="info-row"><text class="info-label">提升空间</text><text class="info-value">{{result.improvementText}}</text></view>
        <view class="row result-buttons">
          <button class="button secondary grow" data-id="{{result.schoolId}}" bindtap="openDetail">查看详情</button>
          <button class="button grow" data-id="{{result.schoolId}}" bindtap="addTarget">{{result.isTargetSchool ? '更新目标等级' : '加入我的目标'}}</button>
        </view>
      </view>
    </view>
  </block>
  <onboarding-overlay
    visible="{{onboarding.visible}}"
    step="{{onboarding.step}}"
    bind:action="onOnboardingAction"
  />
</view>

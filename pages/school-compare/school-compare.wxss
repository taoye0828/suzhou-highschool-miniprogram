.selector-card {
  margin-top: 8rpx;
}

.clear-selection {
  flex-shrink: 0;
  margin: 0;
  padding: 10rpx 14rpx;
  color: #b42318;
  background: transparent;
  font-size: 22rpx;
  line-height: 1.35;
}

.clear-selection::after {
  border: 0;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  color: #0f766e;
  font-weight: 600;
}
.limit-note {
  margin-top: 20rpx;
  padding: 20rpx;
  color: #92400e;
  background: #fef3c7;
  border-radius: 16rpx;
  text-align: center;
}

.empty-selection {
  margin-top: 18rpx;
  line-height: 1.6;
}

.selected-list {
  margin-top: 18rpx;
}

.selected-chip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  background: #edf8f5;
  border-radius: 16rpx;
}

.remove-chip {
  color: #b42318;
  font-size: 24rpx;
}

.compact-empty {
  padding: 34rpx 24rpx;
}

.empty-copy {
  margin-top: 10rpx;
}

.empty-button {
  width: 260rpx;
  margin: 24rpx auto 0;
}

.section-heading {
  align-items: flex-end;
  margin-top: 28rpx;
}

.compare-title {
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.favorite-action {
  flex-shrink: 0;
  min-width: 112rpx;
  margin: 0 0 0 14rpx;
  padding: 12rpx 16rpx;
  color: #64748b;
  background: #f8fafc;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.35;
}

.favorite-action::after {
  border: 0;
}

.favorite-action.active {
  color: #0f766e;
  background: #e7f7f2;
}

.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.target-badge {
  color: #9a5b09;
  background: #fff7df;
}

.compare-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.compare-cell {
  min-width: 0;
  padding: 18rpx;
  background: #f8fafc;
  border-radius: 14rpx;
}

.info-label {
  color: #64748b;
  font-size: 22rpx;
}

.info-value {
  margin-top: 6rpx;
  color: #0f766e;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.45;
}

.difference-text {
  font-size: 23rpx;
}

.history-box {
  margin-top: 16rpx;
  padding: 18rpx;
  background: #f8fafc;
  border-radius: 14rpx;
}

.history-text {
  margin-top: 8rpx;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.55;
}

.compare-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.compare-actions picker {
  flex: 1 1 190rpx;
}

.action-button {
  box-sizing: border-box;
  flex: 1 1 180rpx;
  min-width: 0;
  margin: 0;
  padding-right: 16rpx;
  padding-left: 16rpx;
  font-size: 23rpx;
  line-height: 1.4;
}

picker .action-button {
  width: 100%;
}

.remove-action {
  color: #b42318;
}

.compare-search-input {
  margin-top: 20rpx;
}

.search-empty {
  padding-top: 18rpx;
  text-align: center;
}

@media (max-width: 340px) {
  .compare-grid {
    grid-template-columns: 1fr;
  }
}

<view class="page">
  <view class="card profile-intro">
    <view class="card-title">纯本地学生档案</view>
    <view class="muted small">昵称不要求真实姓名。每个档案的成绩、复盘、目标和学习计划彼此独立。</view>
    <button class="button create-button" bindtap="createProfile">新建档案</button>
  </view>

  <view class="card profile-card" wx:for="{{profiles}}" wx:key="id">
    <view class="row between">
      <view class="grow">
        <view class="card-title">{{item.nickname}}</view>
        <view class="muted small">{{item.examYear}} 年 · {{item.favoritesModeLabel}}</view>
      </view>
      <text wx:if="{{item.isActive}}" class="active-badge">当前</text>
    </view>
    <view class="profile-actions">
      <button wx:if="{{!item.isActive}}" class="button secondary small-button" data-id="{{item.id}}" bindtap="switchProfile">切换</button>
      <button class="button secondary small-button" data-id="{{item.id}}" bindtap="renameProfile">改名</button>
      <picker range="{{favoritesModes}}" range-key="label" data-id="{{item.id}}" bindchange="changeFavoritesMode">
        <view class="button secondary small-button mode-button">收藏模式</view>
      </picker>
      <button class="button danger small-button" data-id="{{item.id}}" bindtap="deleteProfile">删除</button>
    </view>
  </view>
</view>

.profile-intro { margin-top: 24rpx; }
.create-button { margin-top: 24rpx; }
.profile-card { margin-top: 20rpx; }
.active-badge { padding: 8rpx 16rpx; color: #0f766e; background: #dff5ef; border-radius: 999rpx; font-size: 24rpx; font-weight: 700; }

<view class="page">
  <view class="card">
    <view class="card-title">备份本机数据</view>
    <view class="muted small intro">备份当前设备中的学生档案、考试成绩和目标学校。</view>
    <view wx:if="{{exportPreview}}" class="summary">档案 {{exportPreview.profileCount}} 个 · 成绩 {{exportPreview.scoreCount}} 条 · 目标学校 {{exportPreview.targetCount}} 所</view>
    <view class="button-row">
      <button class="button secondary" bindtap="previewExport">查看备份范围</button>
      <button class="button" bindtap="exportBackup">导出备份</button>
    </view>
    <button wx:if="{{exportReady}}" class="button secondary send" bindtap="sendBackupFile">发送备份</button>
  </view>

  <view class="card">
    <view class="card-title">从备份恢复</view>
    <view class="muted small intro">选择此前导出的备份文件，再决定合并或替换本机数据。</view>
    <button class="button secondary choose" bindtap="chooseImportFile">选择备份文件</button>
    <view wx:if="{{importError}}" class="error">{{importError}}</view>
    <view wx:if="{{hasPendingImport}}" class="summary">
      <view class="card-title">{{importFileName}}</view>
      <view class="muted small">档案 {{importPreview.profileCount}} 个 · 成绩 {{importPreview.scoreCount}} 条 · 目标学校 {{importPreview.targetCount}} 所</view>
      <view class="button-row">
        <button class="button secondary" data-mode="merge" bindtap="confirmImport">合并到现有数据</button>
        <button class="button danger" data-mode="overwrite" bindtap="confirmImport">替换本机数据</button>
      </view>
    </view>
  </view>

  <view class="section-title">数据清理</view>
  <view class="card">
    <view class="muted small">清理操作无法撤销，建议先导出备份。</view>
    <view class="button-row">
      <button class="button danger" bindtap="clearCurrentProfile">清除当前档案数据</button>
      <button class="button danger" bindtap="clearAllData">清除全部本机数据</button>
    </view>
  </view>
</view>
